{
  "name": "crm-core-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --external:crypto --external:bcrypt",
    "start": "npm run migrate:deploy && node dist/index.js",
    "dev": "nodemon --legacy-watch --watch src --ext ts --exec \"npm run build && node dist/index.js\"",
    "seed": "tsx src/seed.ts",
    "seed:faqs": "tsx src/scripts/faqs.seed.ts",
    "seed:sales-marks": "tsx src/scripts/salesMarks.seed.ts",
    "seed:spoc-profile": "tsx src/scripts/spocProfile.seed.ts",
    "backfill:assignments": "tsx src/scripts/backfillAssignments.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate:deploy": "npx prisma migrate deploy",
    "perm:prune": "tsx src/scripts/permissions.prune.ts",
    "typecheck": "tsc --noEmit",
    "perm:migrate": "tsx src/scripts/permissions.migrate.ts",
    "seed:pipeline": "tsx src/scripts/pipeline.seed.ts",
    "geo:normalise": "tsx src/scripts/geo.normalise.ts",
    "test:ai": "DATABASE_URL=postgresql://none:none@127.0.0.1:1/none DIRECT_URL=postgresql://none:none@127.0.0.1:1/none DATABASE_URL_AI_READONLY= ANTHROPIC_API_KEY= node --import tsx --test src/tests/*.test.ts",
    "seed:ai": "tsx src/scripts/ai.seed.ts",
    "docs:api": "tsx src/scripts/apiDocs.ts && npm run docs:schema",
    "docs:schema": "tsx src/scripts/schemaHistory.ts"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@prisma/client": "^6.13.0",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "country-state-city": "^3.2.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "pptxgenjs": "^4.0.1",
    "rimraf": "^6.1.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.4.0",
    "@types/nodemailer": "^8.0.1",
    "csv-parse": "^7.0.3",
    "esbuild": "^0.27.3",
    "nodemon": "^3.1.14",
    "prisma": "^6.13.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
