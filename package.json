{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --external:crypto --external:bcrypt",
    "start": "npm run migrate:deploy && node dist/index.js",
    "dev": "nodemon --legacy-watch --watch src --ext ts --exec \"npm run build && node dist/index.js\"",
    "seed": "tsx src/seed.ts",
    "seed-r": "tsx src/seed-requirements.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "fetch": "node prisma/fetchIds.js",
    "migrate:deploy": "npx prisma migrate deploy"
  },
  "prisma": {
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@prisma/client": "^6.13.0",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.4.0",
    "esbuild": "^0.27.3",
    "nodemon": "^3.1.14",
    "prisma": "^6.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
