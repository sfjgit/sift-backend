// File: schema.prisma
// Path: prisma/schema.prisma
//
// SFJBS Sales & Marketing CRM — CRM is the system of record.
// External services (CSR pipeline) talk only via /api/svc/* — never the DB.
//
// Rule of thumb:
//   enum      → states code branches on
//   Lookup    → admin-editable labels / pick-lists (no logic)
//   table     → masters with relations or attributes
//   constants → modules + actions (src/config/permissions.registry.ts)
//
// Org masters are flat. BU and SL are independent — they combine only on ClientSpoc.
//
// Multi-tenant: one database, every company (tenant) sees only its own rows.
// Top-level tables carry tenantId; their children (locations, notes, grants…)
// belong to a tenant through their parent. The Prisma client adds the tenant
// filter itself (src/utils/prisma/tenant.ts) — raw SQL must add it by hand.
// Platform tables (Tenant, ExternalService, PipelineStep) are shared.

generator client {
  provider        = "prisma-client-js"
  // one SQL query per Prisma call (LATERAL joins) instead of one per related
  // table — the DB is ~50 ms away, so this decides list speed (16 Nov 2026)
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS — code depends on these values
// ─────────────────────────────────────────────────────────────────────────────

enum PermissionScope {
  OWN
  TEAM
  REPORTING
  REPORTING_LINE
  DEPARTMENT
  BU
  ALL
}

enum ClientStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum AuthLogType {
  LOGIN
  LOGOUT
  REFRESH
  PASSWORD_RESET
  PASSWORD_CHANGE
  ACCOUNT_CREATED
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
  FAILED_LOGIN
}

// CASPA spoc_data_flag; BOTH_WRONG hides the SPOC from lists unless asked for
enum SpocDataFlag {
  CONTACT_WRONG
  EMAIL_WRONG
  BOTH_WRONG
}

enum EmailStatus {
  UNVERIFIED
  GOOD // Apollo-verified or Bouncer deliverable
  RISKY
  BAD
}

enum ValidationBand {
  READY // >= 75, no failed check
  REVIEW
  NOT_USABLE
}

enum SpocApprovalStatus {
  PENDING
  APPROVED // cleared for outreach
  REJECTED
}

enum StepTarget {
  CLIENT
  SPOC
}

enum StepRunStatus {
  QUEUED // created in CRM, dispatch pending / accepted
  RUNNING
  DONE // finished with something written or found
  EMPTY // finished, nothing found — uses no limit slot
  FAILED
  STOPPED
  DISPATCH_FAILED // never reached the service
  TIMED_OUT
}

enum ClientActivityType {
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_APPROVED
  SPOC_ADDED
  SPOC_UPDATED
  SPOC_REASSIGNED
  NOTE_ADDED
  LOCATION_ADDED
  TECHNOLOGY_UPDATED
  DOCUMENT_ADDED
  FINANCIALS_UPDATED
  PROGRAMS_ADDED
  PROGRAMS_UPDATED
  OUTREACH_GENERATED
  STEP_RUN_STARTED
  STEP_RUN_FINISHED
  STEP_RUN_FAILED
  SPOC_APPROVED
  SPOC_REJECTED
  OUTREACH_UPDATED
  CLIENT_ASSIGNED
  NOTE_UPDATED
  TASK_ADDED
  TASK_UPDATED
  TASK_CLOSED
  SALES_STATUS_CHANGED
  INTERACTION_LOGGED
}

// Outreach is sent by people from their own mailbox; the CRM tracks it.
// DRAFT (written by the pipeline) → REVIEWED (checked by a person) → SENT
// (at least one mail marked sent) → REPLIED | NO_REPLY | BOUNCED.
enum OutreachStatus {
  DRAFT
  REVIEWED
  SENT
  REPLIED
  NO_REPLY
  BOUNCED
}

enum NotificationType {
  SPOC_ASSIGNED
  NOTE_ADDED
  STEP_RUN_FINISHED
  STEP_RUN_FAILED
  SPOC_APPROVAL_NEEDED
  SYSTEM_ALERT
  CLIENT_ASSIGNED
  TICKET_UPDATE
}

enum NotificationReferenceType {
  CLIENT
  SPOC
  STEP_RUN
  SYSTEM_ALERT
  TICKET
}

// run slots reset at the start of each period (Asia/Kolkata)
enum QuotaPeriod {
  DAY
  WEEK
  MONTH
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum TenantStatus {
  ACTIVE
  SUSPENDED // nobody in the tenant can sign in; data is kept
}

// how a CSR programme is run (CSR report annexure: "mode of implementation")
enum CsrImplementationMode {
  DIRECT // by the company itself
  AGENCY // through an implementing agency (NGO, trust, Section 8 company)
}

// what kind of organisation a client is — decides which profile fields apply
enum ClientEntityType {
  COMPANY // has a CIN
  GOVERNMENT // ministries, departments, PSUs' parent bodies
  INSTITUTION // colleges, universities, institutes
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT — one company using the CRM (SFJBS is the first). Platform admins
// (User.isPlatformAdmin) manage tenants from the enterprise console.
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique // "sfjbs" — short, URL-safe
  name      String
  legalName String?
  status    TenantStatus @default(ACTIVE)
  plan      String       @default("STANDARD")
  maxUsers  Int? // null = no limit; counts active users
  settings  Json?

  users         User[]
  roles         Role[]
  lookups       Lookup[]
  businessUnits BusinessUnit[]
  serviceLines  ServiceLine[]
  departments   Department[]
  designations  Designation[]
  clients       Client[]
  clientSpocs   ClientSpoc[]
  stepRuns      StepRun[]
  runQuotas     RunQuota[]
  auditLogs     AuditLog[]
  savedViews    SavedView[]
  faqs          Faq[]
  systemAlerts  SystemAlert[]
  csrAgencies   CsrAgency[]
  workTasks     WorkTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// LOOKUP — one table for every admin-managed pick-list
// type: INDUSTRY, CLIENT_CATEGORY, LOCATION_TYPE, TECH_CATEGORY, DOCUMENT_TYPE,
//       SPOC_SOURCE, SALES_STATUS, PROGRAM_SECTOR ... (validated in service, seeded)
// ─────────────────────────────────────────────────────────────────────────────

model Lookup {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  type     String
  code     String
  label    String
  order    Int?
  isActive Boolean @default(true)
  isSystem Boolean @default(false) // seeded rows code may reference — not deletable
  meta     Json?

  clientsByIndustry      Client[]                 @relation("ClientIndustry")
  clientsByCategory      Client[]                 @relation("ClientCategory")
  clientsByEmployeeSize  Client[]                 @relation("ClientEmployeeSize")
  locationsByType        ClientLocation[]         @relation("LocationType")
  technologiesByCategory ClientTechnology[]       @relation("TechCategory")
  spocsBySource          ClientSpoc[]             @relation("SpocSource")
  spocsByEmailSource     ClientSpoc[]             @relation("SpocEmailSource")
  spocsBySalesStatus     ClientSpoc[]             @relation("SpocSalesStatus")
  spocsByRoleCategory    ClientSpoc[]             @relation("SpocRoleCategory")
  spocsByDecision        ClientSpoc[]             @relation("SpocDecisionAuthority")
  spocsByOrgType         ClientSpoc[]             @relation("SpocOrgType")
  spocsByRevenueBand     ClientSpoc[]             @relation("SpocRevenueBand")
  documentsByType        ClientDocument[]         @relation("DocumentType")
  csrProgramSectors      ClientCsrProgramSector[] @relation("CsrProgramSector")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, type, code])
  @@index([tenantId, type, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// ORG MASTERS — all flat, no parent/child; names unique per tenant
// ─────────────────────────────────────────────────────────────────────────────

model BusinessUnit {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  code     String?
  isActive Boolean @default(true)

  users       UserBusinessUnit[]
  clientSpocs ClientSpoc[]
  clients     Client[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model ServiceLine {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  code     String?
  isActive Boolean @default(true)

  users       UserServiceLine[]
  clientSpocs ClientSpoc[]
  clients     ClientServiceLine[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Department {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  code     String?
  isActive Boolean @default(true)

  users User[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Designation {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  code     String?
  isActive Boolean @default(true)

  users User[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER — people hierarchy (reportingTo / teamLead) stays: scopes depend on it
// ─────────────────────────────────────────────────────────────────────────────

// email is unique across all tenants: sign-in needs only the email, and the
// user's tenant follows from it
model User {
  id           String @id @default(uuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  email        String @unique
  passwordHash String

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  firstName       String
  lastName        String
  middleName      String?
  displayName     String?
  employeeId      String?
  phone           String?
  workingLocation String?
  timezone        String?
  dateOfBirth     DateTime?
  dateOfJoin      DateTime?

  isSuperAdmin    Boolean @default(false) // everything inside their own tenant
  isPlatformAdmin Boolean @default(false) // enterprise console: manages tenants
  isActive        Boolean @default(true)

  legacyCaspaId Int? // tbl_userdetails.id

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  reportingToId String?
  reportingTo   User?   @relation("ReportsTo", fields: [reportingToId], references: [id])
  subordinates  User[]  @relation("ReportsTo")

  teamLeadId  String?
  teamLead    User?   @relation("TeamLeadOf", fields: [teamLeadId], references: [id])
  teamMembers User[]  @relation("TeamLeadOf")

  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdByMe User[]  @relation("UserCreatedBy")

  businessUnits UserBusinessUnit[]
  serviceLines  UserServiceLine[]

  refreshTokens          RefreshToken[]
  authLogs               AuthLogs[]
  impersonationsDone     ImpersonationLog[] @relation("ImpersonatorLogs")
  impersonationsReceived ImpersonationLog[] @relation("ImpersonatedLogs")

  clientsCreated    Client[]           @relation("ClientCreatedBy")
  clientsApproved   Client[]           @relation("ClientApprovedBy")
  clientNotes       ClientNote[]       @relation("ClientNoteAuthor")
  locationsAdded    ClientLocation[]   @relation("LocationAddedBy")
  technologiesAdded ClientTechnology[] @relation("TechnologyAddedBy")

  clientAssignments       ClientAssignment[]     @relation("ClientAssignedTo")
  clientAssignmentsGiven  ClientAssignment[]     @relation("ClientAssignedBy")
  runQuotas               RunQuota[]             @relation("RunQuotaUser")
  runQuotasCreated        RunQuota[]             @relation("RunQuotaCreatedBy")
  spocsHandled            ClientSpoc[]           @relation("SpocHandler")
  spocsAdded              ClientSpoc[]           @relation("SpocAddedBy")
  spocsApproved           ClientSpoc[]           @relation("SpocApprovedBy")
  spocAssignmentsReceived ClientSpocAssignment[] @relation("SpocAssignedTo")
  spocAssignmentsGiven    ClientSpocAssignment[] @relation("SpocAssignedBy")
  keyAccountClients       ClientKeyAccount[]     @relation("ClientKeyAccountUser")
  keyAccountSpocs         ClientSpoc[]           @relation("SpocKeyAccount")
  spocDataFlagsSet        ClientSpoc[]           @relation("SpocDataFlagBy")
  spocProjectsSet         ClientSpoc[]           @relation("SpocProjectSetBy")
  clientProjectsSet       Client[]               @relation("ClientProjectSetBy")
  tasksAssigned           WorkTask[]             @relation("WorkTaskAssignee")
  tasksCreated            WorkTask[]             @relation("WorkTaskCreatedBy")
  tasksClosed             WorkTask[]             @relation("WorkTaskClosedBy")

  clientActivities ClientActivity[]  @relation("ClientActivityActor")
  stepRuns         StepRun[]         @relation("StepRunRequestedBy")
  notifications    Notification[]    @relation("UserNotifications")
  ticketsReported  Ticket[]          @relation("TicketReporter")
  ticketsAssigned  Ticket[]          @relation("TicketAssignee")
  ticketEvents     TicketEvent[]     @relation("TicketEventAuthor")
  alertsResolved   SystemAlert[]     @relation("SystemAlertResolvedBy")
  outreachReviewed OutreachPack[]    @relation("OutreachReviewedBy")
  outreachUpdated  OutreachPack[]    @relation("OutreachStatusBy")
  outreachSent     OutreachMessage[] @relation("OutreachMessageSentBy")
  outreachEdited   OutreachMessage[] @relation("OutreachMessageEditedBy")
  auditLogs        AuditLog[]        @relation("AuditLogActor")

  savedViews  SavedView[] @relation("UserSavedViews")
  faqsCreated Faq[]       @relation("FaqCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeId])
  @@unique([tenantId, legacyCaspaId])
  @@index([tenantId, isActive])
  @@index([roleId])
  @@index([departmentId])
  @@index([designationId])
  @@index([reportingToId])
  @@index([teamLeadId])
}

model UserBusinessUnit {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, businessUnitId])
  @@index([businessUnitId])
}

model UserServiceLine {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceLineId String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, serviceLineId])
  @@index([serviceLineId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuthLogs {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  type      AuthLogType @default(LOGIN)
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

model ImpersonationLog {
  id             String    @id @default(uuid())
  impersonatorId String
  impersonator   User      @relation("ImpersonatorLogs", fields: [impersonatorId], references: [id])
  targetUserId   String
  targetUser     User      @relation("ImpersonatedLogs", fields: [targetUserId], references: [id])
  reason         String?
  ipAddress      String?
  userAgent      String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  @@index([impersonatorId])
  @@index([targetUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ROLES & PERMISSIONS
// Modules + actions live in code: src/config/permissions.registry.ts
// DB stores only grants. One row = one grant. No row = deny.
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isSystem    Boolean @default(false) // system roles can't be edited from UI

  users       User[]
  permissions RolePermission[]
  runQuotas   RunQuota[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model RolePermission {
  id            String          @id @default(uuid())
  roleId        String
  role          Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String // "spocs.assign" — validated against permissions.registry.ts
  scope         PermissionScope @default(OWN) // ignored for unscoped actions

  createdAt DateTime @default(now())

  @@unique([roleId, permissionKey])
  @@index([permissionKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT — company master, flat (no parent/child). Addresses in ClientLocation.
// ─────────────────────────────────────────────────────────────────────────────

// One row per organisation, whatever we sell it (CSR, B2B, …). What differs by
// line of business hangs off the client in its own table (ClientFinancial =
// CSR figures, ClientCorporateFinancial = company figures), never as a copy.
model Client {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  entityType  ClientEntityType @default(COMPANY)
  name        String
  shortName   String?
  cin         String? // unique per tenant
  website     String?
  linkedinUrl String?
  status      ClientStatus     @default(PENDING)

  // head count as found (exact) + the band sales filters on (lookup
  // EMPLOYEE_SIZE, meta { min, max }); a count without a band picks the band
  employeeCount  Int?
  employeeSizeId String?
  employeeSize   Lookup? @relation("ClientEmployeeSize", fields: [employeeSizeId], references: [id])

  // latest CSR year, copied from ClientFinancial for list filters / sort at
  // scale — kept in step by csrSnapshot.service, never edited directly
  csrFy      String?
  csrSpentRs Decimal? @db.Decimal(16, 2)

  industryId String?
  industry   Lookup? @relation("ClientIndustry", fields: [industryId], references: [id])
  categoryId String?
  category   Lookup? @relation("ClientCategory", fields: [categoryId], references: [id])

  legacyCaspaId Int?

  // CASPA "Ideal customer profile" facts with no other home
  foundationName    String?
  foundationWebsite String?
  isListed          Boolean? // listed on an exchange — BRSR applies only then
  subCategory       String?
  linkedinEmployees Int?
  marketCapRs       Decimal? @db.Decimal(18, 2)

  // sales marks (CASPA parity): eligible for CSR, project tags (Lookup PROJECT ids)
  csrEligible    Boolean?
  projectIds     String[]           @default([])
  projectSetById String?
  projectSetBy   User?              @relation("ClientProjectSetBy", fields: [projectSetById], references: [id])
  projectSetAt   DateTime?
  keyAccounts    ClientKeyAccount[]
  tasks          WorkTask[]

  // one BU owns the client; it can be served by several service lines.
  // New SPOCs from pipeline runs take the BU from here.
  businessUnitId String?
  businessUnit   BusinessUnit?       @relation(fields: [businessUnitId], references: [id])
  serviceLines   ClientServiceLine[]

  createdById  String
  createdBy    User      @relation("ClientCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("ClientApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  deletedAt DateTime?

  locations           ClientLocation[]
  technologies        ClientTechnology[]
  spocs               ClientSpoc[]
  notes               ClientNote[]
  activities          ClientActivity[]
  documents           ClientDocument[]
  // CSR-only data lives in ClientCsr* tables; company facts (locations,
  // corporate figures, documents) are shared by every line of business
  csrFinancials       ClientCsrFinancial[]
  corporateFinancials ClientCorporateFinancial[]
  csrPrograms         ClientCsrProgram[]
  outreachPacks       OutreachPack[]
  stepRuns            StepRun[]
  assignments         ClientAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, cin])
  @@unique([tenantId, legacyCaspaId])
  @@index([status])
  @@index([industryId])
  @@index([categoryId])
  @@index([employeeSizeId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([businessUnitId])
  // list: default sort + name / CSR spend sort over a tenant's live rows
  @@index([tenantId, deletedAt, createdAt])
  @@index([tenantId, deletedAt, name])
  @@index([tenantId, deletedAt, csrSpentRs])
  // "contains" search (ILIKE '%x%') — trigram, needs pg_trgm
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([shortName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([cin(ops: raw("gin_trgm_ops"))], type: Gin)
}

// who works a client — set by super admin / clients.assign. Assigned users see
// the client (clients.read scope); SPOCs stay private to their handler.
// History is kept; the active row has endedAt null.
// a personal "key account" star: many users per client, does not grant access
model ClientKeyAccount {
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ClientKeyAccountUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([clientId, userId])
  @@index([userId])
}

model ClientAssignment {
  id           String @id @default(uuid())
  clientId     String
  client       Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId       String
  user         User   @relation("ClientAssignedTo", fields: [userId], references: [id])
  assignedById String
  assignedBy   User   @relation("ClientAssignedBy", fields: [assignedById], references: [id])

  note       String?
  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  @@index([clientId, endedAt])
  @@index([userId, endedAt])
  @@index([assignedById, endedAt])
}

model ClientServiceLine {
  id            String      @id @default(uuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceLineId String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id])

  createdAt DateTime @default(now())

  @@unique([clientId, serviceLineId])
  @@index([serviceLineId])
}

// every address of a client — HQ, branches, dev centres, plants
// one primary per client: partial unique index in migration SQL
model ClientLocation {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  typeId String? // Lookup LOCATION_TYPE: HQ, REGISTERED_OFFICE, BRANCH, DEV_CENTER, PLANT, OFFICE
  type   Lookup? @relation("LocationType", fields: [typeId], references: [id])

  name        String? // "ASM Technologies, NASSCOM IT Park"
  addressLine String?
  city        String?
  district    String?
  state       String?
  country     String?  @default("India")
  pincode     String? // identifier, not a number
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  isPrimary  Boolean @default(false) // main / HQ address
  isActive   Boolean @default(true)
  dmEvidence String? // why decision-makers are here

  addedById   String?
  addedBy     User?    @relation("LocationAddedBy", fields: [addedById], references: [id])
  sourceRunId String?
  sourceRun   StepRun? @relation("LocationSourceRun", fields: [sourceRunId], references: [id])

  spocs ClientSpoc[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, isActive])
  @@index([typeId])
  @@index([state, district])
  // case-insensitive state / city filters (ILIKE)
  @@index([state(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin)
}

// CASPA's cloud / cyber_security / infra / ... columns, as rows
model ClientTechnology {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  categoryId String // Lookup TECH_CATEGORY: CLOUD, CYBER_SECURITY, INFRA, DNI, APPLICATION, CRM, HRMS, LMS, ERP, DIGITAL_MANUFACTURING
  category   Lookup @relation("TechCategory", fields: [categoryId], references: [id])

  details String // what they use / need, e.g. "AWS, Azure"

  addedById   String?
  addedBy     User?    @relation("TechnologyAddedBy", fields: [addedById], references: [id])
  sourceRunId String?
  sourceRun   StepRun? @relation("TechnologySourceRun", fields: [sourceRunId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, categoryId])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT SPOC — one row per person; email globally unique (store lowercased)
// BU + SL meet here — this is where the combo lives
// ─────────────────────────────────────────────────────────────────────────────

model ClientSpoc {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  locationId String?
  location   ClientLocation? @relation(fields: [locationId], references: [id])

  firstName   String
  lastName    String?
  nameKey     String // normalized full name — dedupe per client
  email       String? // unique per tenant
  phone       String?
  designation String? // free text as found
  department  String?
  linkedinUrl String?
  seniority   String?

  totalExpYears      Decimal? @db.Decimal(4, 1)
  currentOrgExpYears Decimal? @db.Decimal(4, 1)

  handlerId String
  handler   User   @relation("SpocHandler", fields: [handlerId], references: [id])

  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  serviceLineId  String
  serviceLine    ServiceLine  @relation(fields: [serviceLineId], references: [id])

  sourceId      String?
  source        Lookup? @relation("SpocSource", fields: [sourceId], references: [id])
  emailSourceId String?
  emailSource   Lookup? @relation("SpocEmailSource", fields: [emailSourceId], references: [id])
  salesStatusId String?
  salesStatus   Lookup? @relation("SpocSalesStatus", fields: [salesStatusId], references: [id])

  // latest validation — computed, latest wins
  emailStatus      EmailStatus     @default(UNVERIFIED)
  validationScore  Int?
  validationBand   ValidationBand?
  validationChecks Json? // { v_name, v_designation, v_email, v_linkedin, v_phone, suggestion }
  validatedAt      DateTime?

  // where each contact field came from — { email: "report", phone: "apollo", linkedin: "brightdata" }
  fieldSources Json?
  reviewFlag   Boolean @default(false)
  reviewReason String?

  // a person decides who gets outreach; services only fill and score
  approvalStatus SpocApprovalStatus @default(PENDING)
  approvedById   String?
  approvedBy     User?              @relation("SpocApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  approvalNote   String?

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)
  notes     String?

  // more contact + the SPOC's own place (CASPA spoc_edit)
  phone2        String?
  phone3        String?
  state         String?
  district      String?
  city          String?
  pincode       String?
  address       String?
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  distanceKm    Decimal? @db.Decimal(8, 1) // from our nearest office
  callConnected Boolean? // CASPA "Connected call status"

  // profile (admin-editable lists)
  roleCategoryId      String?
  roleCategory        Lookup? @relation("SpocRoleCategory", fields: [roleCategoryId], references: [id])
  decisionAuthorityId String?
  decisionAuthority   Lookup? @relation("SpocDecisionAuthority", fields: [decisionAuthorityId], references: [id])
  orgTypeId           String?
  orgType             Lookup? @relation("SpocOrgType", fields: [orgTypeId], references: [id])
  revenueBandId       String?
  revenueBand         Lookup? @relation("SpocRevenueBand", fields: [revenueBandId], references: [id])

  notesList ClientNote[]
  tasks     WorkTask[]

  // sales marks (CASPA parity)
  erp              String? // the ERP the SPOC's org runs (CASPA tbl_spoc_list.erp)
  dataFlag         SpocDataFlag?
  dataFlagById     String?
  dataFlagBy       User?         @relation("SpocDataFlagBy", fields: [dataFlagById], references: [id])
  dataFlagAt       DateTime?
  keyAccountUserId String? // one holder; others see it locked
  keyAccountUser   User?         @relation("SpocKeyAccount", fields: [keyAccountUserId], references: [id])
  projectIds       String[]      @default([])
  projectSetById   String?
  projectSetBy     User?         @relation("SpocProjectSetBy", fields: [projectSetById], references: [id])
  projectSetAt     DateTime?

  legacyCaspaId Int?

  sourceRunId String?
  sourceRun   StepRun? @relation("SpocSourceRun", fields: [sourceRunId], references: [id])

  addedById String
  addedBy   User   @relation("SpocAddedBy", fields: [addedById], references: [id])

  assignments   ClientSpocAssignment[]
  activities    ClientActivity[]
  outreachPacks OutreachPack[]
  stepRuns      StepRun[]              @relation("StepRunSpoc")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, legacyCaspaId])
  @@index([tenantId, createdAt])
  @@index([clientId, isActive])
  @@index([clientId, nameKey])
  @@index([locationId])
  @@index([handlerId, isActive])
  @@index([businessUnitId, serviceLineId])
  @@index([serviceLineId])
  @@index([salesStatusId])
  @@index([validationBand])
  @@index([approvalStatus])
  @@index([dataFlag])
  @@index([keyAccountUserId])
  // SPOC + global search
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
}

// handler history; active row = endedAt null
model ClientSpocAssignment {
  id     String     @id @default(uuid())
  spocId String
  spoc   ClientSpoc @relation(fields: [spocId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("SpocAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User   @relation("SpocAssignedBy", fields: [assignedById], references: [id])

  reason     String?
  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  @@index([spocId, endedAt])
  @@index([assignedToId, endedAt])
}

model ClientNote {
  id       String      @id @default(uuid())
  clientId String
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // a comment on one SPOC (shows on the SPOC and the client); null = client note
  spocId   String?
  spoc     ClientSpoc? @relation(fields: [spocId], references: [id], onDelete: SetNull)
  authorId String
  author   User        @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  content  String
  editedAt DateTime?
  // a comment / observation on one section of the client page (CASPA "tab
  // comments": info, branches, csr, reports, spocs, …); null = general note
  section  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([spocId])
}

// a to-do or a call to make, on a client or one of its SPOCs (CASPA s_tasks)
model WorkTask {
  id       String      @id @default(uuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  spocId   String?
  spoc     ClientSpoc? @relation(fields: [spocId], references: [id], onDelete: SetNull)

  kind   WorkTaskKind   @default(TASK)
  title  String
  notes  String?
  dueAt  DateTime?
  status WorkTaskStatus @default(OPEN)

  assigneeId  String
  assignee    User      @relation("WorkTaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User      @relation("WorkTaskCreatedBy", fields: [createdById], references: [id])
  closeNote   String?
  closedAt    DateTime?
  closedById  String?
  closedBy    User?     @relation("WorkTaskClosedBy", fields: [closedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, assigneeId, status])
  @@index([clientId])
  @@index([spocId])
}

enum WorkTaskKind {
  TASK
  CALL
  MEETING
}

enum WorkTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model ClientActivity {
  id       String      @id @default(uuid())
  clientId String
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  spocId   String?
  spoc     ClientSpoc? @relation(fields: [spocId], references: [id])

  actorId String? // null = system / external service
  actor   User?   @relation("ClientActivityActor", fields: [actorId], references: [id])

  type    ClientActivityType
  summary String
  meta    Json?

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([spocId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CSR DATA — what CASPA crammed into tbl_csr columns
// ─────────────────────────────────────────────────────────────────────────────

model ClientDocument {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  typeId String
  type   Lookup @relation("DocumentType", fields: [typeId], references: [id])

  fy        String // "2025-2026"
  fileKey   String // S3 key
  fileName  String?
  sourceUrl String?
  sha256    String?

  sourceRunId String?
  sourceRun   StepRun? @relation("DocumentSourceRun", fields: [sourceRunId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, typeId, fy])
  @@index([clientId])
}

// CSR figures — one row per client per FY; only accepted figures, flagged ones
// stay in StepRun.viewData
model ClientCsrFinancial {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fy           String
  obligationRs Decimal? @db.Decimal(16, 2)
  budgetRs     Decimal? @db.Decimal(16, 2)
  spentRs      Decimal? @db.Decimal(16, 2)
  unspentRs    Decimal? @db.Decimal(16, 2)

  evidence   String?
  confidence Decimal? @db.Decimal(3, 2)
  isLocked   Boolean  @default(false) // manually confirmed — services never overwrite

  sourceRunId String?
  sourceRun   StepRun? @relation("FinancialSourceRun", fields: [sourceRunId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, fy])
}

// company figures per FY (any client, not only CSR) — typed columns, one row
// per year, so history is kept and reports can sum / sort
model ClientCorporateFinancial {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fy                  String // "2025-2026"
  revenueRs           Decimal? @db.Decimal(18, 2)
  netProfitRs         Decimal? @db.Decimal(18, 2)
  paidUpCapitalRs     Decimal? @db.Decimal(18, 2)
  authorisedCapitalRs Decimal? @db.Decimal(18, 2)
  netWorthRs          Decimal? @db.Decimal(18, 2)

  source   String? // "MCA filing", "annual report", a URL…
  isLocked Boolean @default(false) // entered / confirmed by a person

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, fy])
}

// one CSR programme / project per client per FY — the columns of the project
// table in the company's annual CSR report (CSR Rules annexure)
model ClientCsrProgram {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fy      String
  name    String
  // lower-case, punctuation-free name: the same programme across years, and no
  // near-duplicate rows within a year ("Project Shiksha" = "project shiksha.")
  nameKey String

  // Schedule VII activities (lookup PROGRAM_SECTOR); sectorText keeps the source's
  // wording so nothing is lost when it matches no list entry
  sectors    ClientCsrProgramSector[]
  sectorText String?

  isOngoing   Boolean? // ongoing (multi-year) project vs one-year
  duration    String? // as reported: "3 years", "2023-2026"
  isLocalArea Boolean? // local area of the company's operations (Sec. 135(5))

  locations    ClientCsrProgramLocation[]
  locationNote String? // where, as written in the source

  budgetRs             Decimal? @db.Decimal(16, 2) // amount allocated
  spentRs              Decimal? @db.Decimal(16, 2) // spent in the FY
  unspentTransferredRs Decimal? @db.Decimal(16, 2) // moved to the Unspent CSR Account

  mode     CsrImplementationMode?
  agencyId String?
  agency   CsrAgency?             @relation(fields: [agencyId], references: [id])

  beneficiaries String?
  // UN Sustainable Development Goals the programme maps to (1–17)
  sdgs          Int[]    @default([])
  sourceUrl     String?

  sourceRunId String?
  sourceRun   StepRun? @relation("ProgramSourceRun", fields: [sourceRunId], references: [id])
  isLocked    Boolean  @default(false) // entered / corrected by a person — the pipeline never overwrites
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, fy, nameKey])
  @@index([clientId, nameKey])
  @@index([agencyId])
}

model ClientCsrProgramSector {
  programId String
  program   ClientCsrProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  sectorId  String
  sector    Lookup           @relation("CsrProgramSector", fields: [sectorId], references: [id])

  @@id([programId, sectorId])
  @@index([sectorId])
}

// where a programme runs — state / district are filterable ("spends in Karnataka")
model ClientCsrProgramLocation {
  id        String           @id @default(uuid())
  programId String
  program   ClientCsrProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  state     String
  district  String?
  city      String?
  // both or neither, within range (CHECK constraints in the migration)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  @@index([programId])
  @@index([state, district])
}

// implementing agencies (NGOs, trusts, Section 8 companies) — one list per
// tenant, shared by every client's programmes
model CsrAgency {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name           String
  nameKey        String // same normalisation as programme names
  registrationNo String? // MCA CSR-1 number, e.g. CSR00012345
  website        String?

  programs ClientCsrProgram[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, nameKey])
  @@unique([tenantId, registrationNo])
}

// ─────────────────────────────────────────────────────────────────────────────
// OUTREACH — always a new pack (keeps history); sending comes later
// ─────────────────────────────────────────────────────────────────────────────

model OutreachPack {
  id       String     @id @default(uuid())
  clientId String
  client   Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  spocId   String
  spoc     ClientSpoc @relation(fields: [spocId], references: [id], onDelete: Cascade)

  fileKey String? // docx in S3
  model   String?

  sourceRunId String?
  sourceRun   StepRun? @relation("OutreachSourceRun", fields: [sourceRunId], references: [id])

  messages OutreachMessage[]

  status       OutreachStatus @default(DRAFT)
  reviewedById String?
  reviewedBy   User?          @relation("OutreachReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  outcomeNote  String? // what the reply said, why it bounced ...
  repliedAt    DateTime?
  statusById   String? // who last changed the status
  statusBy     User?          @relation("OutreachStatusBy", fields: [statusById], references: [id])
  statusAt     DateTime?

  createdAt DateTime @default(now())

  @@index([spocId, createdAt])
  @@index([clientId, status])
  @@index([status])
}

model OutreachMessage {
  id     String       @id @default(uuid())
  packId String
  pack   OutreachPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  sequenceNo Int // 0 = first mail, 1..n = follow-ups
  subject    String
  body       String

  // a person edits before sending; the pipeline's text is not kept separately
  editedById String?
  editedBy   User?     @relation("OutreachMessageEditedBy", fields: [editedById], references: [id])
  editedAt   DateTime?
  sentAt     DateTime? // when the person sent it from their mailbox
  sentById   String?
  sentBy     User?     @relation("OutreachMessageSentBy", fields: [sentById], references: [id])

  @@unique([packId, sequenceNo])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTERNAL SERVICES + STEP RUNS
// ExternalService = one partner (CSR pipeline). Outbound URL + inbound key.
// Outbound key read from env var named in outboundKeyEnv; inbound key stored as hash.
// ─────────────────────────────────────────────────────────────────────────────

model ExternalService {
  id   String @id @default(uuid())
  code String @unique // "CSR_PIPELINE"
  name String

  baseUrl        String?
  outboundKeyEnv String? // e.g. "CSR_PIPELINE_KEY"
  inboundKeyHash String?
  scopes         String[] // "clients:read", "step-runs:write", "documents:write"

  timeoutMins      Int @default(120)
  maxDispatchTries Int @default(5)

  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  lastHealthAt DateTime?
  lastHealthOk Boolean?

  steps PipelineStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PipelineStep {
  id        String          @id @default(uuid())
  serviceId String
  service   ExternalService @relation(fields: [serviceId], references: [id])

  key             String // "spoc_finder", "programs_figures", "validate" ...
  label           String
  target          StepTarget
  uiOrder         Int?
  userClientLimit Int? // null = unlimited; super admin bypasses
  // a finished step is not run again for the client within this many days
  // unless its input changed; step_runs.rerun / super admin may force it
  rerunAfterDays  Int?
  isActive        Boolean    @default(true)
  config          Json? // step-specific options sent with the job

  runs   StepRun[]
  quotas RunQuota[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, key])
  @@index([isActive])
}

model StepRun {
  id       String       @id @default(uuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  stepId   String
  step     PipelineStep @relation(fields: [stepId], references: [id])

  idempotencyKey String  @unique // hash(step + client + spoc + options) — blocks double clicks
  externalJobId  String? @unique

  // "Run all steps" grouping — technical, not org hierarchy
  parentRunId String?
  parentRun   StepRun?  @relation("RunChain", fields: [parentRunId], references: [id])
  childRuns   StepRun[] @relation("RunChain")

  clientId String
  client   Client      @relation(fields: [clientId], references: [id])
  spocId   String?
  spoc     ClientSpoc? @relation("StepRunSpoc", fields: [spocId], references: [id])

  requestedById String
  requestedBy   User   @relation("StepRunRequestedBy", fields: [requestedById], references: [id])

  options Json? // exactly what was sent

  status        StepRunStatus @default(QUEUED)
  progress      Int? // 0-100
  note          String? // short plain-English line for the button
  dispatchTries Int           @default(0)

  viewData      Json? // skipped rows, conflicts, waiting-for-email, flagged figures
  resultSummary Json? // what the CRM wrote: { contacts: { created, skipped[] }, ... }

  errorCode     String?
  errorMessage  String?
  howToContinue String?
  costUsd       Decimal? @db.Decimal(10, 4)
  credits       Json? // { apollo: 3, brightdata: 2 }

  startedAt      DateTime?
  finishedAt     DateTime?
  lastCallbackAt DateTime?
  nextCheckAt    DateTime? // fallback status check if callbacks stop

  events StepRunEvent[]

  spocsCreated  ClientSpoc[]         @relation("SpocSourceRun")
  locations     ClientLocation[]     @relation("LocationSourceRun")
  technologies  ClientTechnology[]   @relation("TechnologySourceRun")
  documents     ClientDocument[]     @relation("DocumentSourceRun")
  csrFinancials ClientCsrFinancial[] @relation("FinancialSourceRun")
  csrPrograms   ClientCsrProgram[]   @relation("ProgramSourceRun")
  outreachPacks OutreachPack[]       @relation("OutreachSourceRun")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, nextCheckAt])
  @@index([stepId, requestedById, status]) // limit check
  @@index([clientId, createdAt])
  // per-step latest run, "steps done" filters, re-run guard
  @@index([clientId, stepId, status, createdAt])
  @@index([spocId])
  @@index([parentRunId])
}

// Run slots: at most maxRuns started runs per period. stepId null = all steps
// together. Subject: userId, else roleId, else everyone — for the same step +
// period the most specific rule wins. Super admin has no slots.
model RunQuota {
  id       String        @id @default(uuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  stepId   String?
  step     PipelineStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  roleId   String?
  role     Role?         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?         @relation("RunQuotaUser", fields: [userId], references: [id], onDelete: Cascade)

  period   QuotaPeriod
  maxRuns  Int
  isActive Boolean     @default(true)

  createdById String
  createdBy   User   @relation("RunQuotaCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive])
}

// append-only: dispatch attempts, callbacks, status changes, errors
model StepRunEvent {
  id    String  @id @default(uuid())
  runId String
  run   StepRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  fromStatus StepRunStatus?
  toStatus   StepRunStatus?
  message    String
  payload    Json? // masked request/response

  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS + AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  severity NotificationSeverity @default(INFO)
  title    String
  body     String?
  link     String? // in-app path to open, e.g. /clients/<id>?tab=pipeline

  referenceId   String
  referenceType NotificationReferenceType

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// Problems the system raises (engine down, runs failing, server errors).
// One open row per key: a repeat bumps count/lastSeenAt instead of a new row,
// so admins get one notification, not one per retry.
// tenantId null = platform-wide (the shared pipeline engine) — every tenant sees it.
model SystemAlert {
  id       String               @id @default(uuid())
  tenantId String?
  tenant   Tenant?              @relation(fields: [tenantId], references: [id])
  key      String // "engine-down:CSR_PIPELINE", "run-failed:figures:UNREACHABLE"
  severity NotificationSeverity
  source   String // pipeline | engine | api
  title    String
  body     String?
  link     String?
  meta     Json?

  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  resolvedAt   DateTime?
  resolvedById String? // null with resolvedAt = cleared by the system
  resolvedBy   User?     @relation("SystemAlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([key, resolvedAt])
  @@index([resolvedAt, lastSeenAt])
  @@index([tenantId])
}

model AuditLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  actorId  String
  actor    User   @relation("AuditLogActor", fields: [actorId], references: [id])

  action    String
  module    String
  recordId  String
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([module, recordId])
  @@index([actorId])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SAVED VIEWS + HELP
// ─────────────────────────────────────────────────────────────────────────────

// table / report presets; config is opaque to the backend
model SavedView {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation("UserSavedViews", fields: [userId], references: [id], onDelete: Cascade)
  module    String // "clients" | "spocs" | "users" | "reports" | "step_runs" ...
  name      String
  config    Json // columns, filters, sort, density, pageSize, report spec
  isDefault Boolean  @default(false) // one default per user+module
  isShared  Boolean  @default(false) // visible (read-only) to everyone
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, module])
  @@index([tenantId, module, isShared])
}

// help is per tenant — a new tenant starts with a copy of the platform's FAQs
model Faq {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  question        String
  answer          String // markdown-lite: paragraphs, "- " bullets, **bold**, `code`
  category        String // "Getting started", "Clients", "SPOCs", "Reports", "Admin", ...
  module          String? // page key for contextual help
  order           Int      @default(0)
  isPublished     Boolean  @default(true)
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)
  createdById     String?
  createdBy       User?    @relation("FaqCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, category, order])
  @@index([module])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI assistant layer (docs: CRM_AI_Assistant_Layer_Spec_v1). READ-ONLY by design:
// these are the only tables the AI service writes, and only through the main
// client. Business tables are read through aiDb (src/config/aiDb.ts) with a
// SELECT-only Postgres role. tenantId is a plain column (no FK) so the tenant
// guard scopes it like every other tenant table.
// ─────────────────────────────────────────────────────────────────────────────

enum AiMode {
  OFF
  COMMAND
  CANVAS
}

enum AiUsageMode {
  COMMAND
  CANVAS
  EXPORT
}

enum AiQuotaPeriod {
  DAY
  WEEK
  MONTH
}

// one row per tenant — org-wide switches + monthly budget
model AiModeSetting {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  commandEnabled   Boolean  @default(false)
  canvasEnabled    Boolean  @default(false)
  monthlyBudgetInr Decimal  @default(5000) @db.Decimal(12, 2)
  alertThresholds  Json     @default("[50, 80, 100]")
  alertsSent       Json     @default("{}") // { "2026-11": [50, 80] } — each threshold alerts once a month
  updatedById      String?
  updatedAt        DateTime @updatedAt
}

model AiUserPreference {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String   @unique
  mode      AiMode   @default(OFF)
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// roleId null = the tenant's default (covers roles created later)
model AiQuotaPolicy {
  id          String        @id @default(uuid())
  tenantId    String
  roleId      String?
  mode        AiUsageMode
  period      AiQuotaPeriod
  maxCount    Int? // null = unlimited
  isActive    Boolean       @default(true)
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([tenantId, roleId, mode, period])
}

model AiUserQuotaOverride {
  id          String        @id @default(uuid())
  tenantId    String
  userId      String
  mode        AiUsageMode
  period      AiQuotaPeriod
  maxCount    Int?
  reason      String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, mode, period])
  @@index([tenantId])
}

// platform-wide: a price change adds a row, old audit rows keep their cost
model AiModelPricing {
  id                   String   @id @default(uuid())
  provider             String // "anthropic" | "self_hosted"
  model                String // "claude-haiku-5-5"
  inputPerMTokUsd      Decimal  @db.Decimal(10, 4)
  outputPerMTokUsd     Decimal  @db.Decimal(10, 4)
  cacheReadPerMTokUsd  Decimal  @db.Decimal(10, 4)
  cacheWritePerMTokUsd Decimal  @db.Decimal(10, 4)
  usdToInr             Decimal  @db.Decimal(10, 4)
  effectiveFrom        DateTime
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([model, effectiveFrom])
}

// platform-wide: masked phrasings only ("show {status} clients in {industry}"),
// never business values
model CommandTemplate {
  id        String   @id @default(uuid())
  template  String   @unique
  action    String
  paramMap  Json
  source    String   @default("llm") // llm | seed | manual
  hitCount  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// a saved canvas: the spec only — reruns fetch fresh data, no LLM call
model ReportTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  prompt      String?
  spec        Json
  createdById String
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdById])
}

model AiAuditLog {
  id               String       @id @default(uuid())
  tenantId         String
  userId           String
  roleId           String?
  buId             String?
  mode             AiMode
  usageMode        AiUsageMode?
  input            String
  template         String?
  tier             String // guard | template | llm | fallback | none
  action           String?
  params           Json?
  outcome          String // success | rejected_destructive | rejected_permission | rejected_scope | rejected_quota | budget_exhausted | invalid | error
  countsToQuota    Boolean      @default(false)
  model            String?
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  costUsd          Decimal      @default(0) @db.Decimal(12, 6)
  costInr          Decimal      @default(0) @db.Decimal(12, 4)
  latencyMs        Int
  createdAt        DateTime     @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([roleId, createdAt])
  @@index([outcome])
  @@index([tier, createdAt])
}

// ── AI threads (13 Nov 2026) ─────────────────────────────────────────────────
// A saved conversation with the assistant, like a chat in Claude / ChatGPT: the
// first request builds a canvas, follow-ups change it. The thread keeps the
// latest canvas spec (never numbers — those are re-read live on every open).
model AiThread {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  title      String
  /**
   * the page the thread was started from ("/spocs")
   */
  page       String?
  /**
   * latest resolved canvas spec; null until the first canvas
   */
  spec       Json?
  pinned     Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  turns      AiTurn[]

  @@index([tenantId, userId, updatedAt])
}

// one exchange: what the user asked and what the assistant did with it
model AiTurn {
  id        String   @id @default(uuid())
  threadId  String
  thread    AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq       Int
  input     String
  /**
   * canvas | clarify | rejected | error | explain | edit
   */
  kind      String
  /**
   * what the assistant said (what changed, the question, the explanation)
   */
  message   String?
  /**
   * clarify: the "did you mean" choices
   */
  options   Json?
  /**
   * the canvas spec after this turn (canvas / edit turns)
   */
  spec      Json?
  /**
   * llm | memory | local — memory and local cost nothing
   */
  tier      String
  createdAt DateTime @default(now())

  @@unique([threadId, seq])
}

// What the assistant has learned: a masked request (names replaced by
// placeholders) on a given canvas shape → the answer it gave. The same
// question later — even with other names or dates — is answered from here
// without calling the LLM. Holds no business values.
model AiAnswerMemory {
  id         String   @id @default(uuid())
  tenantId   String
  /**
   * sha256(masked request | canvas shape | catalog)
   */
  key        String
  masked     String
  tool       String
  answer     Json
  hits       Int      @default(0)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([tenantId, key])
}

// ── recycle bin & undo (14 Nov 2026) ─────────────────────────────────────────
// Every delete and change made through the app keeps the row as it was before,
// so anything can be put back exactly — one row, or everything one request
// (or one AI action) did, as a batch. Nothing written here is ever deleted.
enum ChangeOp {
  CREATE
  UPDATE
  DELETE
}

model ChangeLog {
  id           String    @id @default(uuid())
  tenantId     String?
  /**
   * who did it; null = system / scripts
   */
  actorId      String?
  /**
   * one request / one AI action — "undo" puts all of it back
   */
  batchId      String
  /**
   * web | ai | system | restore
   */
  source       String    @default("web")
  op           ChangeOp
  model        String
  /**
   * Clients, SPOCs, Comments, Tasks… (for the bin's tabs)
   */
  category     String
  /**
   * a readable name of the record ("Tata Elxsi Ltd", "Asha Rao")
   */
  label        String?
  /**
   * the primary key, e.g. { "id": "…" } or { "clientId": "…", "userId": "…" }
   */
  recordKey    Json
  /**
   * the row before the change (UPDATE / DELETE)
   */
  before       Json?
  /**
   * what was written (UPDATE: the changed fields; CREATE: the new row)
   */
  after        Json?
  restoredAt   DateTime?
  restoredById String?
  createdAt    DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, op, category])
  @@index([batchId])
}

// ─── Support tickets (16 Nov 2026) ─────────────────────────────────────────────
// "Report a problem" and "Suggest a feature" share one table but follow
// different pipelines (status sets differ by kind — see ticket.service.ts).
// A bug carries what the browser saw: screenshot, a replay of the last minutes
// and of the reporter's reproduction, console errors, failed API calls, clicks.

enum TicketKind {
  BUG
  FEATURE
}

model Ticket {
  id             String     @id @default(uuid())
  tenantId       String
  /// #42 — readable number shown everywhere
  number         Int        @default(autoincrement())
  kind           TicketKind
  title          String
  /// what happened / what the idea is
  description    String?
  /// bugs: what should have happened
  expected       String?
  /// BUG: NEW → NEEDS_REPRO → INVESTIGATING → FIXED → CLOSED (or WONT_FIX)
  /// FEATURE: NEW → UNDER_REVIEW → PLANNED → IN_PROGRESS → SHIPPED (or DECLINED)
  status         String     @default("NEW")
  /// LOW | MEDIUM | HIGH | BLOCKER
  severity       String?
  reporterId     String
  reporter       User       @relation("TicketReporter", fields: [reporterId], references: [id])
  assigneeId     String?
  assignee       User?      @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  pageUrl        String?
  /// browser, screen, role, console errors, failed API calls, clicks (no secrets)
  context        Json?
  /// the system's own reading of the evidence (+ AI diagnosis when asked)
  diagnosis      Json?
  /// support asked the reporter to show the steps again
  reproRequested Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  closedAt       DateTime?

  attachments TicketAttachment[]
  events      TicketEvent[]

  @@index([tenantId, kind, status])
  @@index([reporterId])
}

model TicketAttachment {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// SCREENSHOT | REPLAY (the minutes before reporting) | REPRO (recorded steps)
  kind        String
  mime        String
  sizeBytes   Int
  /// gzip JSON for replays, jpeg for screenshots
  data        Bytes
  durationMs  Int?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

model TicketEvent {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("TicketEventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// CREATED | COMMENT | STATUS | ASSIGN | SEVERITY | REPRO_REQUESTED | REPRO_ADDED | DIAGNOSIS
  type      String
  body      String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
