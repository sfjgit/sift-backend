// File: schema.prisma
// Path: prisma/schema.prisma
//
// SFJBS Sales & Marketing CRM — CRM is the system of record.
// External services (CSR pipeline) talk only via /api/svc/* — never the DB.
//
// Rule of thumb:
//   enum      → states code branches on
//   Lookup    → admin-editable labels / pick-lists (no logic)
//   table     → masters with relations or attributes
//   constants → modules + actions (src/config/permissions.registry.ts)
//
// Org masters are flat. BU and SL are independent — they combine only on ClientSpoc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS — code depends on these values
// ─────────────────────────────────────────────────────────────────────────────

enum PermissionScope {
  OWN
  TEAM
  REPORTING
  REPORTING_LINE
  DEPARTMENT
  BU
  ALL
}

enum ClientStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum AuthLogType {
  LOGIN
  LOGOUT
  REFRESH
  PASSWORD_RESET
  PASSWORD_CHANGE
  ACCOUNT_CREATED
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
  FAILED_LOGIN
}

enum EmailStatus {
  UNVERIFIED
  GOOD // Apollo-verified or Bouncer deliverable
  RISKY
  BAD
}

enum ValidationBand {
  READY // >= 75, no failed check
  REVIEW
  NOT_USABLE
}

enum SpocApprovalStatus {
  PENDING
  APPROVED // cleared for outreach
  REJECTED
}

enum StepTarget {
  CLIENT
  SPOC
}

enum StepRunStatus {
  QUEUED // created in CRM, dispatch pending / accepted
  RUNNING
  DONE // finished with something written or found
  EMPTY // finished, nothing found — uses no limit slot
  FAILED
  STOPPED
  DISPATCH_FAILED // never reached the service
  TIMED_OUT
}

enum ClientActivityType {
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_APPROVED
  SPOC_ADDED
  SPOC_UPDATED
  SPOC_REASSIGNED
  NOTE_ADDED
  LOCATION_ADDED
  TECHNOLOGY_UPDATED
  DOCUMENT_ADDED
  FINANCIALS_UPDATED
  PROGRAMS_ADDED
  OUTREACH_GENERATED
  STEP_RUN_STARTED
  STEP_RUN_FINISHED
  STEP_RUN_FAILED
  SPOC_APPROVED
  SPOC_REJECTED
  OUTREACH_UPDATED
  CLIENT_ASSIGNED
}

// Outreach is sent by people from their own mailbox; the CRM tracks it.
// DRAFT (written by the pipeline) → REVIEWED (checked by a person) → SENT
// (at least one mail marked sent) → REPLIED | NO_REPLY | BOUNCED.
enum OutreachStatus {
  DRAFT
  REVIEWED
  SENT
  REPLIED
  NO_REPLY
  BOUNCED
}

enum NotificationType {
  SPOC_ASSIGNED
  NOTE_ADDED
  STEP_RUN_FINISHED
  STEP_RUN_FAILED
  SPOC_APPROVAL_NEEDED
  SYSTEM_ALERT
  CLIENT_ASSIGNED
}

enum NotificationReferenceType {
  CLIENT
  SPOC
  STEP_RUN
  SYSTEM_ALERT
}

// run slots reset at the start of each period (Asia/Kolkata)
enum QuotaPeriod {
  DAY
  WEEK
  MONTH
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ─────────────────────────────────────────────────────────────────────────────
// LOOKUP — one table for every admin-managed pick-list
// type: INDUSTRY, CLIENT_CATEGORY, LOCATION_TYPE, TECH_CATEGORY, DOCUMENT_TYPE,
//       SPOC_SOURCE, SALES_STATUS, PROGRAM_SECTOR ... (validated in service, seeded)
// ─────────────────────────────────────────────────────────────────────────────

model Lookup {
  id       String  @id @default(uuid())
  type     String
  code     String
  label    String
  order    Int?
  isActive Boolean @default(true)
  isSystem Boolean @default(false) // seeded rows code may reference — not deletable
  meta     Json?

  clientsByIndustry      Client[]           @relation("ClientIndustry")
  clientsByCategory      Client[]           @relation("ClientCategory")
  locationsByType        ClientLocation[]   @relation("LocationType")
  technologiesByCategory ClientTechnology[] @relation("TechCategory")
  spocsBySource          ClientSpoc[]       @relation("SpocSource")
  spocsByEmailSource     ClientSpoc[]       @relation("SpocEmailSource")
  spocsBySalesStatus     ClientSpoc[]       @relation("SpocSalesStatus")
  documentsByType        ClientDocument[]   @relation("DocumentType")
  programsBySector       ClientProgram[]    @relation("ProgramSector")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, code])
  @@index([type, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// ORG MASTERS — all flat, no parent/child
// ─────────────────────────────────────────────────────────────────────────────

model BusinessUnit {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String? @unique
  isActive Boolean @default(true)

  users       UserBusinessUnit[]
  clientSpocs ClientSpoc[]
  clients     Client[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

model ServiceLine {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String? @unique
  isActive Boolean @default(true)

  users       UserServiceLine[]
  clientSpocs ClientSpoc[]
  clients     ClientServiceLine[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

model Department {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String?
  isActive Boolean @default(true)

  users User[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

model Designation {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String?
  isActive Boolean @default(true)

  users User[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER — people hierarchy (reportingTo / teamLead) stays: scopes depend on it
// ─────────────────────────────────────────────────────────────────────────────

// File: schema.prisma
// Path: prisma/schema.prisma
// (User model — only change: legacyCaspaId added)

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  firstName       String
  lastName        String
  middleName      String?
  displayName     String?
  employeeId      String?   @unique
  phone           String?
  workingLocation String?
  timezone        String?
  dateOfBirth     DateTime?
  dateOfJoin      DateTime?

  isSuperAdmin Boolean @default(false)
  isActive     Boolean @default(true)

  legacyCaspaId Int? @unique // tbl_userdetails.id

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  reportingToId String?
  reportingTo   User?   @relation("ReportsTo", fields: [reportingToId], references: [id])
  subordinates  User[]  @relation("ReportsTo")

  teamLeadId  String?
  teamLead    User?   @relation("TeamLeadOf", fields: [teamLeadId], references: [id])
  teamMembers User[]  @relation("TeamLeadOf")

  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdByMe User[]  @relation("UserCreatedBy")

  businessUnits UserBusinessUnit[]
  serviceLines  UserServiceLine[]

  refreshTokens          RefreshToken[]
  authLogs               AuthLogs[]
  impersonationsDone     ImpersonationLog[] @relation("ImpersonatorLogs")
  impersonationsReceived ImpersonationLog[] @relation("ImpersonatedLogs")

  clientsCreated    Client[]           @relation("ClientCreatedBy")
  clientsApproved   Client[]           @relation("ClientApprovedBy")
  clientNotes       ClientNote[]       @relation("ClientNoteAuthor")
  locationsAdded    ClientLocation[]   @relation("LocationAddedBy")
  technologiesAdded ClientTechnology[] @relation("TechnologyAddedBy")

  clientAssignments       ClientAssignment[]     @relation("ClientAssignedTo")
  clientAssignmentsGiven  ClientAssignment[]     @relation("ClientAssignedBy")
  runQuotas               RunQuota[]             @relation("RunQuotaUser")
  runQuotasCreated        RunQuota[]             @relation("RunQuotaCreatedBy")
  spocsHandled            ClientSpoc[]           @relation("SpocHandler")
  spocsAdded              ClientSpoc[]           @relation("SpocAddedBy")
  spocsApproved           ClientSpoc[]           @relation("SpocApprovedBy")
  spocAssignmentsReceived ClientSpocAssignment[] @relation("SpocAssignedTo")
  spocAssignmentsGiven    ClientSpocAssignment[] @relation("SpocAssignedBy")

  clientActivities ClientActivity[]  @relation("ClientActivityActor")
  stepRuns         StepRun[]         @relation("StepRunRequestedBy")
  notifications    Notification[]    @relation("UserNotifications")
  alertsResolved   SystemAlert[]     @relation("SystemAlertResolvedBy")
  outreachReviewed OutreachPack[]    @relation("OutreachReviewedBy")
  outreachUpdated  OutreachPack[]    @relation("OutreachStatusBy")
  outreachSent     OutreachMessage[] @relation("OutreachMessageSentBy")
  outreachEdited   OutreachMessage[] @relation("OutreachMessageEditedBy")
  auditLogs        AuditLog[]        @relation("AuditLogActor")

  savedViews  SavedView[] @relation("UserSavedViews")
  faqsCreated Faq[]       @relation("FaqCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([roleId])
  @@index([departmentId])
  @@index([designationId])
  @@index([reportingToId])
  @@index([teamLeadId])
}

model UserBusinessUnit {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, businessUnitId])
  @@index([businessUnitId])
}

model UserServiceLine {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceLineId String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, serviceLineId])
  @@index([serviceLineId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuthLogs {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  type      AuthLogType @default(LOGIN)
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

model ImpersonationLog {
  id             String    @id @default(uuid())
  impersonatorId String
  impersonator   User      @relation("ImpersonatorLogs", fields: [impersonatorId], references: [id])
  targetUserId   String
  targetUser     User      @relation("ImpersonatedLogs", fields: [targetUserId], references: [id])
  reason         String?
  ipAddress      String?
  userAgent      String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  @@index([impersonatorId])
  @@index([targetUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ROLES & PERMISSIONS
// Modules + actions live in code: src/config/permissions.registry.ts
// DB stores only grants. One row = one grant. No row = deny.
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false) // system roles can't be edited from UI

  users       User[]
  permissions RolePermission[]
  runQuotas   RunQuota[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id            String          @id @default(uuid())
  roleId        String
  role          Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String // "spocs.assign" — validated against permissions.registry.ts
  scope         PermissionScope @default(OWN) // ignored for unscoped actions

  createdAt DateTime @default(now())

  @@unique([roleId, permissionKey])
  @@index([permissionKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT — company master, flat (no parent/child). Addresses in ClientLocation.
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id          String       @id @default(uuid())
  name        String
  shortName   String?
  cin         String?      @unique
  website     String?
  linkedinUrl String?
  status      ClientStatus @default(PENDING)

  industryId String?
  industry   Lookup? @relation("ClientIndustry", fields: [industryId], references: [id])
  categoryId String?
  category   Lookup? @relation("ClientCategory", fields: [categoryId], references: [id])

  legacyCaspaId Int? @unique

  // one BU owns the client; it can be served by several service lines.
  // New SPOCs from pipeline runs take the BU from here.
  businessUnitId String?
  businessUnit   BusinessUnit?       @relation(fields: [businessUnitId], references: [id])
  serviceLines   ClientServiceLine[]

  createdById  String
  createdBy    User      @relation("ClientCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("ClientApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  deletedAt DateTime?

  locations     ClientLocation[]
  technologies  ClientTechnology[]
  spocs         ClientSpoc[]
  notes         ClientNote[]
  activities    ClientActivity[]
  documents     ClientDocument[]
  financials    ClientFinancial[]
  programs      ClientProgram[]
  outreachPacks OutreachPack[]
  stepRuns      StepRun[]
  assignments   ClientAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([industryId])
  @@index([categoryId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([businessUnitId])
  // list: default sort + name sort over live rows
  @@index([deletedAt, createdAt])
  @@index([deletedAt, name])
  // "contains" search (ILIKE '%x%') — trigram, needs pg_trgm
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([shortName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([cin(ops: raw("gin_trgm_ops"))], type: Gin)
}

// who works a client — set by super admin / clients.assign. Assigned users see
// the client (clients.read scope); SPOCs stay private to their handler.
// History is kept; the active row has endedAt null.
model ClientAssignment {
  id           String @id @default(uuid())
  clientId     String
  client       Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId       String
  user         User   @relation("ClientAssignedTo", fields: [userId], references: [id])
  assignedById String
  assignedBy   User   @relation("ClientAssignedBy", fields: [assignedById], references: [id])

  note       String?
  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  @@index([clientId, endedAt])
  @@index([userId, endedAt])
  @@index([assignedById, endedAt])
}

model ClientServiceLine {
  id            String      @id @default(uuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceLineId String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id])

  createdAt DateTime @default(now())

  @@unique([clientId, serviceLineId])
  @@index([serviceLineId])
}

// every address of a client — HQ, branches, dev centres, plants
// one primary per client: partial unique index in migration SQL
model ClientLocation {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  typeId String? // Lookup LOCATION_TYPE: HQ, REGISTERED_OFFICE, BRANCH, DEV_CENTER, PLANT, OFFICE
  type   Lookup? @relation("LocationType", fields: [typeId], references: [id])

  name        String? // "ASM Technologies, NASSCOM IT Park"
  addressLine String?
  city        String?
  district    String?
  state       String?
  country     String?  @default("India")
  pincode     String? // identifier, not a number
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  isPrimary  Boolean @default(false) // main / HQ address
  isActive   Boolean @default(true)
  dmEvidence String? // why decision-makers are here

  addedById   String?
  addedBy     User?    @relation("LocationAddedBy", fields: [addedById], references: [id])
  sourceRunId String?
  sourceRun   StepRun? @relation("LocationSourceRun", fields: [sourceRunId], references: [id])

  spocs ClientSpoc[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, isActive])
  @@index([typeId])
  @@index([state, district])
  // case-insensitive state / city filters (ILIKE)
  @@index([state(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin)
}

// CASPA's cloud / cyber_security / infra / ... columns, as rows
model ClientTechnology {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  categoryId String // Lookup TECH_CATEGORY: CLOUD, CYBER_SECURITY, INFRA, DNI, APPLICATION, CRM, HRMS, LMS, ERP, DIGITAL_MANUFACTURING
  category   Lookup @relation("TechCategory", fields: [categoryId], references: [id])

  details String // what they use / need, e.g. "AWS, Azure"

  addedById   String?
  addedBy     User?    @relation("TechnologyAddedBy", fields: [addedById], references: [id])
  sourceRunId String?
  sourceRun   StepRun? @relation("TechnologySourceRun", fields: [sourceRunId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, categoryId])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT SPOC — one row per person; email globally unique (store lowercased)
// BU + SL meet here — this is where the combo lives
// ─────────────────────────────────────────────────────────────────────────────

model ClientSpoc {
  id String @id @default(uuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  locationId String?
  location   ClientLocation? @relation(fields: [locationId], references: [id])

  firstName   String
  lastName    String?
  nameKey     String // normalized full name — dedupe per client
  email       String? @unique
  phone       String?
  designation String? // free text as found
  department  String?
  linkedinUrl String?
  seniority   String?

  totalExpYears      Decimal? @db.Decimal(4, 1)
  currentOrgExpYears Decimal? @db.Decimal(4, 1)

  handlerId String
  handler   User   @relation("SpocHandler", fields: [handlerId], references: [id])

  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  serviceLineId  String
  serviceLine    ServiceLine  @relation(fields: [serviceLineId], references: [id])

  sourceId      String?
  source        Lookup? @relation("SpocSource", fields: [sourceId], references: [id])
  emailSourceId String?
  emailSource   Lookup? @relation("SpocEmailSource", fields: [emailSourceId], references: [id])
  salesStatusId String?
  salesStatus   Lookup? @relation("SpocSalesStatus", fields: [salesStatusId], references: [id])

  // latest validation — computed, latest wins
  emailStatus      EmailStatus     @default(UNVERIFIED)
  validationScore  Int?
  validationBand   ValidationBand?
  validationChecks Json? // { v_name, v_designation, v_email, v_linkedin, v_phone, suggestion }
  validatedAt      DateTime?

  // where each contact field came from — { email: "report", phone: "apollo", linkedin: "brightdata" }
  fieldSources Json?
  reviewFlag   Boolean @default(false)
  reviewReason String?

  // a person decides who gets outreach; services only fill and score
  approvalStatus SpocApprovalStatus @default(PENDING)
  approvedById   String?
  approvedBy     User?              @relation("SpocApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  approvalNote   String?

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)
  notes     String?

  legacyCaspaId Int? @unique

  sourceRunId String?
  sourceRun   StepRun? @relation("SpocSourceRun", fields: [sourceRunId], references: [id])

  addedById String
  addedBy   User   @relation("SpocAddedBy", fields: [addedById], references: [id])

  assignments   ClientSpocAssignment[]
  activities    ClientActivity[]
  outreachPacks OutreachPack[]
  stepRuns      StepRun[]              @relation("StepRunSpoc")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, isActive])
  @@index([clientId, nameKey])
  @@index([locationId])
  @@index([handlerId, isActive])
  @@index([businessUnitId, serviceLineId])
  @@index([serviceLineId])
  @@index([salesStatusId])
  @@index([validationBand])
  @@index([approvalStatus])
  // SPOC + global search
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
}

// handler history; active row = endedAt null
model ClientSpocAssignment {
  id     String     @id @default(uuid())
  spocId String
  spoc   ClientSpoc @relation(fields: [spocId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("SpocAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User   @relation("SpocAssignedBy", fields: [assignedById], references: [id])

  reason     String?
  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  @@index([spocId, endedAt])
  @@index([assignedToId, endedAt])
}

model ClientNote {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model ClientActivity {
  id       String      @id @default(uuid())
  clientId String
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  spocId   String?
  spoc     ClientSpoc? @relation(fields: [spocId], references: [id])

  actorId String? // null = system / external service
  actor   User?   @relation("ClientActivityActor", fields: [actorId], references: [id])

  type    ClientActivityType
  summary String
  meta    Json?

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([spocId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CSR DATA — what CASPA crammed into tbl_csr columns
// ─────────────────────────────────────────────────────────────────────────────

model ClientDocument {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  typeId String
  type   Lookup @relation("DocumentType", fields: [typeId], references: [id])

  fy        String // "2025-2026"
  fileKey   String // S3 key
  fileName  String?
  sourceUrl String?
  sha256    String?

  sourceRunId String?
  sourceRun   StepRun? @relation("DocumentSourceRun", fields: [sourceRunId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, typeId, fy])
  @@index([clientId])
}

// one row per client per FY — only accepted figures; flagged ones stay in StepRun.viewData
model ClientFinancial {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fy           String
  obligationRs Decimal? @db.Decimal(16, 2)
  budgetRs     Decimal? @db.Decimal(16, 2)
  spentRs      Decimal? @db.Decimal(16, 2)
  unspentRs    Decimal? @db.Decimal(16, 2)

  evidence   String?
  confidence Decimal? @db.Decimal(3, 2)
  isLocked   Boolean  @default(false) // manually confirmed — services never overwrite

  sourceRunId String?
  sourceRun   StepRun? @relation("FinancialSourceRun", fields: [sourceRunId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, fy])
}

model ClientProgram {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fy   String
  name String

  sectorId String?
  sector   Lookup? @relation("ProgramSector", fields: [sectorId], references: [id])

  budgetRs      Decimal? @db.Decimal(16, 2)
  locations     String?
  beneficiaries String?
  implementor   String?
  sourceUrl     String?

  sourceRunId String?
  sourceRun   StepRun? @relation("ProgramSourceRun", fields: [sourceRunId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, fy, name])
  @@index([sectorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// OUTREACH — always a new pack (keeps history); sending comes later
// ─────────────────────────────────────────────────────────────────────────────

model OutreachPack {
  id       String     @id @default(uuid())
  clientId String
  client   Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  spocId   String
  spoc     ClientSpoc @relation(fields: [spocId], references: [id], onDelete: Cascade)

  fileKey String? // docx in S3
  model   String?

  sourceRunId String?
  sourceRun   StepRun? @relation("OutreachSourceRun", fields: [sourceRunId], references: [id])

  messages OutreachMessage[]

  status       OutreachStatus @default(DRAFT)
  reviewedById String?
  reviewedBy   User?          @relation("OutreachReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  outcomeNote  String? // what the reply said, why it bounced ...
  repliedAt    DateTime?
  statusById   String? // who last changed the status
  statusBy     User?          @relation("OutreachStatusBy", fields: [statusById], references: [id])
  statusAt     DateTime?

  createdAt DateTime @default(now())

  @@index([spocId, createdAt])
  @@index([clientId, status])
  @@index([status])
}

model OutreachMessage {
  id     String       @id @default(uuid())
  packId String
  pack   OutreachPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  sequenceNo Int // 0 = first mail, 1..n = follow-ups
  subject    String
  body       String

  // a person edits before sending; the pipeline's text is not kept separately
  editedById String?
  editedBy   User?     @relation("OutreachMessageEditedBy", fields: [editedById], references: [id])
  editedAt   DateTime?
  sentAt     DateTime? // when the person sent it from their mailbox
  sentById   String?
  sentBy     User?     @relation("OutreachMessageSentBy", fields: [sentById], references: [id])

  @@unique([packId, sequenceNo])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTERNAL SERVICES + STEP RUNS
// ExternalService = one partner (CSR pipeline). Outbound URL + inbound key.
// Outbound key read from env var named in outboundKeyEnv; inbound key stored as hash.
// ─────────────────────────────────────────────────────────────────────────────

model ExternalService {
  id   String @id @default(uuid())
  code String @unique // "CSR_PIPELINE"
  name String

  baseUrl        String?
  outboundKeyEnv String? // e.g. "CSR_PIPELINE_KEY"
  inboundKeyHash String?
  scopes         String[] // "clients:read", "step-runs:write", "documents:write"

  timeoutMins      Int @default(120)
  maxDispatchTries Int @default(5)

  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  lastHealthAt DateTime?
  lastHealthOk Boolean?

  steps PipelineStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PipelineStep {
  id        String          @id @default(uuid())
  serviceId String
  service   ExternalService @relation(fields: [serviceId], references: [id])

  key             String // "spoc_finder", "programs_figures", "validate" ...
  label           String
  target          StepTarget
  uiOrder         Int?
  userClientLimit Int? // null = unlimited; super admin bypasses
  // a finished step is not run again for the client within this many days
  // unless its input changed; step_runs.rerun / super admin may force it
  rerunAfterDays  Int?
  isActive        Boolean    @default(true)
  config          Json? // step-specific options sent with the job

  runs   StepRun[]
  quotas RunQuota[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, key])
  @@index([isActive])
}

model StepRun {
  id     String       @id @default(uuid())
  stepId String
  step   PipelineStep @relation(fields: [stepId], references: [id])

  idempotencyKey String  @unique // hash(step + client + spoc + options) — blocks double clicks
  externalJobId  String? @unique

  // "Run all steps" grouping — technical, not org hierarchy
  parentRunId String?
  parentRun   StepRun?  @relation("RunChain", fields: [parentRunId], references: [id])
  childRuns   StepRun[] @relation("RunChain")

  clientId String
  client   Client      @relation(fields: [clientId], references: [id])
  spocId   String?
  spoc     ClientSpoc? @relation("StepRunSpoc", fields: [spocId], references: [id])

  requestedById String
  requestedBy   User   @relation("StepRunRequestedBy", fields: [requestedById], references: [id])

  options Json? // exactly what was sent

  status        StepRunStatus @default(QUEUED)
  progress      Int? // 0-100
  note          String? // short plain-English line for the button
  dispatchTries Int           @default(0)

  viewData      Json? // skipped rows, conflicts, waiting-for-email, flagged figures
  resultSummary Json? // what the CRM wrote: { contacts: { created, skipped[] }, ... }

  errorCode     String?
  errorMessage  String?
  howToContinue String?
  costUsd       Decimal? @db.Decimal(10, 4)
  credits       Json? // { apollo: 3, brightdata: 2 }

  startedAt      DateTime?
  finishedAt     DateTime?
  lastCallbackAt DateTime?
  nextCheckAt    DateTime? // fallback status check if callbacks stop

  events StepRunEvent[]

  spocsCreated  ClientSpoc[]       @relation("SpocSourceRun")
  locations     ClientLocation[]   @relation("LocationSourceRun")
  technologies  ClientTechnology[] @relation("TechnologySourceRun")
  documents     ClientDocument[]   @relation("DocumentSourceRun")
  financials    ClientFinancial[]  @relation("FinancialSourceRun")
  programs      ClientProgram[]    @relation("ProgramSourceRun")
  outreachPacks OutreachPack[]     @relation("OutreachSourceRun")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextCheckAt])
  @@index([stepId, requestedById, status]) // limit check
  @@index([clientId, createdAt])
  // per-step latest run, "steps done" filters, re-run guard
  @@index([clientId, stepId, status, createdAt])
  @@index([spocId])
  @@index([parentRunId])
}

// Run slots: at most maxRuns started runs per period. stepId null = all steps
// together. Subject: userId, else roleId, else everyone — for the same step +
// period the most specific rule wins. Super admin has no slots.
model RunQuota {
  id     String        @id @default(uuid())
  stepId String?
  step   PipelineStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  roleId String?
  role   Role?         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userId String?
  user   User?         @relation("RunQuotaUser", fields: [userId], references: [id], onDelete: Cascade)

  period   QuotaPeriod
  maxRuns  Int
  isActive Boolean     @default(true)

  createdById String
  createdBy   User   @relation("RunQuotaCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// append-only: dispatch attempts, callbacks, status changes, errors
model StepRunEvent {
  id    String  @id @default(uuid())
  runId String
  run   StepRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  fromStatus StepRunStatus?
  toStatus   StepRunStatus?
  message    String
  payload    Json? // masked request/response

  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS + AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  severity NotificationSeverity @default(INFO)
  title    String
  body     String?
  link     String? // in-app path to open, e.g. /clients/<id>?tab=pipeline

  referenceId   String
  referenceType NotificationReferenceType

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// Problems the system raises (engine down, runs failing, server errors).
// One open row per key: a repeat bumps count/lastSeenAt instead of a new row,
// so admins get one notification, not one per retry.
model SystemAlert {
  id       String               @id @default(uuid())
  key      String // "engine-down:CSR_PIPELINE", "run-failed:figures:UNREACHABLE"
  severity NotificationSeverity
  source   String // pipeline | engine | api
  title    String
  body     String?
  link     String?
  meta     Json?

  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  resolvedAt   DateTime?
  resolvedById String? // null with resolvedAt = cleared by the system
  resolvedBy   User?     @relation("SystemAlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([key, resolvedAt])
  @@index([resolvedAt, lastSeenAt])
}

model AuditLog {
  id      String @id @default(uuid())
  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id])

  action    String
  module    String
  recordId  String
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([module, recordId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SAVED VIEWS + HELP
// ─────────────────────────────────────────────────────────────────────────────

// table / report presets; config is opaque to the backend
model SavedView {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserSavedViews", fields: [userId], references: [id], onDelete: Cascade)
  module    String // "clients" | "spocs" | "users" | "reports" | "step_runs" ...
  name      String
  config    Json // columns, filters, sort, density, pageSize, report spec
  isDefault Boolean  @default(false) // one default per user+module
  isShared  Boolean  @default(false) // visible (read-only) to everyone
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, module])
  @@index([module, isShared])
}

model Faq {
  id              String   @id @default(uuid())
  question        String
  answer          String // markdown-lite: paragraphs, "- " bullets, **bold**, `code`
  category        String // "Getting started", "Clients", "SPOCs", "Reports", "Admin", ...
  module          String? // page key for contextual help
  order           Int      @default(0)
  isPublished     Boolean  @default(true)
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)
  createdById     String?
  createdBy       User?    @relation("FaqCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, order])
  @@index([module])
}
