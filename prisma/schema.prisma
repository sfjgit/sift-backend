generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — used by the app at runtime
  // directUrl = env("DIRECT_URL") // direct — used by migrate/introspect
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum PermissionScope {
  OWN
  TEAM
  REPORTING
  REPORTING_LINE
  DEPARTMENT
  BU
  ALL
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
  REPLACED
  FILLED // ← their allocated openings are done
  EXPIRED // ← deadline passed, never filled
}

enum RequirementType {
  CONTRACT
  PERMANENT
  CONTRACT_TO_HIRE
  FREELANCE
}

enum RemoteType {
  ONSITE
  REMOTE
  HYBRID
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RequirementStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  CLOSED
  CANCELLED
}

enum SalaryType {
  MONTHLY
  ANNUAL
  HOURLY
  DAILY
}

enum ActivityType {
  REQUIREMENT_CREATED
  REQUIREMENT_APPROVED
  REQUIREMENT_CLOSED
  STATUS_CHANGED
  MANAGER_ASSIGNED
  RECRUITER_ASSIGNED
  ASSIGNMENT_REMOVED
  NOTE_ADDED
  DOCUMENT_UPLOADED
  ISSUE_RAISED
  ISSUE_RESOLVED
  STATS_UPDATED
}

enum NotificationType {
  REQUIREMENT_ASSIGNED
  STATUS_CHANGED
  REQUIREMENT_CLOSED
  NOTE_ADDED
  ISSUE_RAISED
  DEADLINE_BREACHED
  DEADLINE_REMINDER
  INTERVIEW_SCHEDULED
}

enum NotificationReferenceType {
  REQUIREMENT
  ASSIGNMENT
  NOTE
  DOCUMENT
  PIPELINE
}

enum ClientStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// BUSINESS UNIT
// ancestorIds — includes self + all ancestors, maintained by buService on write
// always store exact BU id on any relation
// filter by passing any ancestor BU id → ancestorIds: { has: buId }
// ─────────────────────────────────────────────────────────────────────────────

model BusinessUnit {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String? @unique
  isActive Boolean @default(true)

  parentBUId String?
  parentBU   BusinessUnit?  @relation("BUHierarchy", fields: [parentBUId], references: [id])
  childBUs   BusinessUnit[] @relation("BUHierarchy")

  ancestorIds String[]

  clients     Client[]
  clientSpocs ClientSpoc[]

  requirementsBU Requirement[]           @relation("RequirementBU")
  assignmentsBU  RequirementAssignment[] @relation("AssignmentBU")

  createdAt DateTime @default(now())

  users User[]

  @@index([isActive])
  @@index([parentBUId])
  @@index([ancestorIds], type: Gin)
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICE LINE — flat, KaaS / TaaS / CSR / OEM
// ─────────────────────────────────────────────────────────────────────────────

model ServiceLine {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String? @unique
  isActive Boolean @default(true)

  clientSpocs    ClientSpoc[]
  requirements   Requirement[]
  pipelineStages PipelineStage[]

  createdAt DateTime @default(now())
  users     User[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// DEPARTMENT — flat label, admin-managed
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String?
  isActive Boolean @default(true)

  users       User[]
  assignments RequirementAssignment[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  firstName       String
  lastName        String
  middleName      String?
  displayName     String?
  employeeId      String?   @unique
  phone           String?
  workingLocation String?
  timezone        String?
  dateOfBirth     DateTime?
  dateOfJoin      DateTime?

  retrievalPassword String?

  isSuperAdmin Boolean @default(false)
  isActive     Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  reportingToId String?
  reportingTo   User?   @relation("ReportsTo", fields: [reportingToId], references: [id])

  subordinates User[] @relation("ReportsTo")

  teamLeadId  String?
  teamLead    User?   @relation("TeamLeadOf", fields: [teamLeadId], references: [id])
  teamMembers User[]  @relation("TeamLeadOf")

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdByMe User[]  @relation("UserCreatedBy")

  refreshTokens RefreshToken[]

  spocsHandled ClientSpoc[] @relation("SpocHandler")
  spocsAdded   ClientSpoc[] @relation("SpocAddedBy")

  clientsCreated      Client[]     @relation("ClientCreatedBy")
  clientsApproved     Client[]     @relation("ClientApprovedBy")
  clientNotesAuthored ClientNote[] @relation("ClientNoteAuthor")

  requirementsCreated      Requirement[]              @relation("RequirementCreatedBy")
  requirementsApproved     Requirement[]              @relation("RequirementApprovedBy")
  requirementsClosed       Requirement[]              @relation("RequirementClosedBy")
  requirementStatusChanges RequirementStatusHistory[] @relation("RequirementStatusChangedBy")
  requirementActivities    RequirementActivity[]      @relation("RequirementActivityActor")
  requirementNotesAuthored RequirementNote[]          @relation("RequirementNoteAuthor")
  requirementDocsRaised    RequirementDocument[]      @relation("RequirementDocRaisedBy")
  requirementDocsResolved  RequirementDocument[]      @relation("RequirementDocResolvedBy")

  assignmentsGiven    RequirementAssignment[] @relation("AssignedByUser")
  assignmentsReceived RequirementAssignment[] @relation("AssignedToUser")

  // pipeline relations
  pipelinesHandling    RequirementCandidatePipeline[] @relation("PipelineRecruiter")
  pipelinesStageUpdate RequirementCandidatePipeline[] @relation("PipelineStageUpdatedBy")
  pipelinesSubmitted   RequirementCandidatePipeline[] @relation("PipelineSubmittedBy")
  pipelinesOffered     RequirementCandidatePipeline[] @relation("PipelineOfferedBy")
  pipelinesRejected    RequirementCandidatePipeline[] @relation("PipelineRejectedBy")
  pipelineStageChanges CandidatePipelineStageLog[]    @relation("StageLogChangedBy")

  candidateSnapshotsCreated CandidateSnapshot[] @relation("SnapshotCreatedBy")

  notifications Notification[] @relation("UserNotifications")
  auditLogs     AuditLog[]     @relation("AuditLogActor")

  SpocDM ClientSpocDM[] @relation("SpocDM")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  userAppCredentials UserAppCredential[]

  jdsParsed ParsedJDLibrary[] @relation("JDParsedBy")

  canAssignTo     UserAssignableTo[] @relation("CanAssignTo")
  assignableBy    UserAssignableTo[] @relation("AssignableBy")
  assignableAdded UserAssignableTo[] @relation("AssignableAddedBy")

  buId          String?
  bu            BusinessUnit? @relation(fields: [buId], references: [id])
  servicelineId String?
  serviceline   ServiceLine?  @relation(fields: [servicelineId], references: [id])
  authLogs      AuthLogs[]

  createdInterviews CandidateInterviewSchedule[] @relation("InterviewScheduledBy")

  @@index([email])
  @@index([isActive])
  @@index([roleId])
  @@index([departmentId])
  @@index([reportingToId])
  @@index([teamLeadId])
}

enum AuthLogType {
  LOGIN
  LOGOUT
  REFRESH
  PASSWORD_RESET
  PASSWORD_CHANGE
  EMAIL_VERIFICATION
  EMAIL_CHANGE
  PHONE_VERIFICATION

  ACCOUNT_CREATED
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
  FAILED_LOGIN
}

model AuthLogs {
  id        String      @id @default(uuid())
  userId    String
  ip        String?
  userAgent String?
  type      AuthLogType @default(LOGIN)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model UserAssignableTo {
  id       String @id @default(uuid())
  userId   String // the one who can assign
  targetId String // the extra user they can assign to

  user   User @relation("CanAssignTo", fields: [userId], references: [id])
  target User @relation("AssignableBy", fields: [targetId], references: [id])

  addedById String
  addedBy   User   @relation("AssignableAddedBy", fields: [addedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, targetId])
  @@index([userId])
}

model UserAppCredential {
  id        String   @id @default(uuid())
  userId    String
  appName   String // 'NAUKRI', 'LINKEDIN', 'GITHUB', etc.
  email     String
  password  String // AES-256 encrypted
  metadata  Json? // any extra fields — API keys, tokens, org IDs, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appName]) // one credential per app per user
  @@map("user_app_credentials")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ROLES & PERMISSIONS
// ─────────────────────────────────────────────────────────────────────────────

enum RoleCanonical {
  ADMIN
  SUPER_ADMIN

  CSM
  SR_CSM

  RECRUITER
  DELIVERY_LEAD
  DELIVERY_MANAGER

  DEVELOPER
  UNMAPPED
}


model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

   canonical   RoleCanonical? @default(UNMAPPED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id       String  @id @default(uuid())
  name     String  @unique // "users", "clients", "requirements"
  label    String // "Users", "Clients", "Requirements"
  order    Int?
  isActive Boolean @default(true)

  permissions RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  id     String @id @default(uuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  module String

  moduleId String?
  modules  Module? @relation(fields: [moduleId], references: [id])

  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  canViewScope   PermissionScope @default(OWN)
  canAddScope    PermissionScope @default(OWN)
  canEditScope   PermissionScope @default(OWN)
  canDeleteScope PermissionScope @default(OWN)

  @@unique([roleId, module])
}

enum AgreementType {
  BAND
  FIXED
}

model Client {
  id       String       @id @default(uuid())
  name     String
  vmsName  String?
  industry String?
  website  String?
  country  String?
  state    String?
  city     String?
  address  String?
  status   ClientStatus @default(PENDING)

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  parentClientId String?
  parentClient   Client?  @relation("ClientFamily", fields: [parentClientId], references: [id])
  childClients   Client[] @relation("ClientFamily")

  createdById  String
  createdBy    User      @relation("ClientCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("ClientApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  deletedAt DateTime?

  spocs        ClientSpoc[]
  requirements Requirement[]
  notes        ClientNote[]
  assignments  RequirementAssignment[]

  agreementType   AgreementType? @default(FIXED)
  percentageValue Decimal?

  bands Band[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([businessUnitId])
  @@index([deletedAt])
}

model Band {
  id String @id @default(uuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name String?
  code String

  rangeFrom Decimal?
  rangeTo   Decimal?
  value     Decimal?

  experience Decimal?

  createdAt DateTime @default(now())

  @@index([clientId])
}

// model ClientAgreement {
//   id            String      @id @default(uuid())
//   clientId      String
//   client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
//   agreementType AgreementType

//   startDate     DateTime
//   endDate       DateTime
//   createdAt     DateTime @default(now())
// }

model ClientSpoc {
  id String @id @default(uuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  firstName   String
  lastName    String
  email       String?
  phone       String?
  designation String?
  department  String?

  handlerId String
  handler   User   @relation("SpocHandler", fields: [handlerId], references: [id])

  serviceLineId String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id])

  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)
  notes     String?

  addedById String
  addedBy   User   @relation("SpocAddedBy", fields: [addedById], references: [id])

  requirements Requirement[]

  clientSpocDms ClientSpocDM[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, email, serviceLineId])
  @@index([clientId, isActive])
  @@index([handlerId, isActive])
  @@index([businessUnitId])
  @@index([serviceLineId])
}

model ClientSpocDM {
  id String @id @default(uuid())

  spocId String
  spoc   ClientSpoc @relation(fields: [spocId], references: [id])

  dmId String
  dm   User   @relation("SpocDM", fields: [dmId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientNote {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REQUIREMENT
// ─────────────────────────────────────────────────────────────────────────────

model Requirement {
  id      String @id @default(uuid())
  reqCode String @unique

  // ── Core ──────────────────────────────────────────────────────────────────
  title       String
  description String?
  jobType     RequirementType
  remoteType  RemoteType
  priority    Priority        @default(MEDIUM)
  jobOpenFor  JobOpenFor      @default(EXTERNAL) // EXTERNAL / INTERNAL / BOTH

  // ── Skills ────────────────────────────────────────────────────────────────
  primarySkills String[] // top 3-5 must-have — replaces flat skills[]
  keySkills     String[] // all other required skills

  // ── Location ──────────────────────────────────────────────────────────────
  city    String?
  state   String?
  country String?

  // ── Experience ────────────────────────────────────────────────────────────
  experienceMin Float?
  experienceMax Float?

  // ── Compensation ──────────────────────────────────────────────────────────
  salaryMin               Float?
  salaryMax               Float?
  salaryType              SalaryType?
  salaryCurrency          String?     @default("INR")
  bonusAmount             Float?
  hideSalaryFromCandidate Boolean     @default(false)
  showMedianSalary        Boolean     @default(false)

  // ── Employment details ────────────────────────────────────────────────────
  education      String? // "B.Tech / B.E. in CS"
  functionalArea String? // "Engineering", "Sales"
  shift          String? // "Morning" / "Night" / "Flexible"

  // ── Sourcing strategy ─────────────────────────────────────────────────────
  targetCompanies  String[] // companies to target
  noPoachCompanies String[] // companies not to poach from

  // ── JD file ───────────────────────────────────────────────────────────────
  jdFileKey    String?
  jdFileName   String?
  jdFileType   String?
  jdUploadedAt DateTime?

  // ── JD parse metadata (set after /jd/parse, cleared on manual override) ──
  jdParsedAt     DateTime?
  jdParseStatus  JDParseStatus? // PARSED / FAILED / MANUALLY_OVERRIDDEN
  jdParsedFields String[] // which fields were autofilled from JD

  // ── Relations ─────────────────────────────────────────────────────────────
  clientSpocId String?
  clientSpoc   ClientSpoc? @relation(fields: [clientSpocId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  businessUnitId String?
  businessUnit   BusinessUnit? @relation("RequirementBU", fields: [businessUnitId], references: [id])

  serviceLineId String?
  serviceLine   ServiceLine? @relation(fields: [serviceLineId], references: [id])

  // ── Openings ──────────────────────────────────────────────────────────────
  // filledOpenings, activeApplications, interviewsScheduled, offersRolledOut
  // are all DROPPED — computed from pipeline rows on demand, never stored
  totalOpenings Int @default(1)

  // ── Dates ─────────────────────────────────────────────────────────────────
  startDate      DateTime?
  targetDate     DateTime? // expected onboarding date — was endDate, renamed
  respondBy      DateTime?
  turnaroundDays Int?

  // ── Status & closure ──────────────────────────────────────────────────────
  status        RequirementStatus @default(DRAFT)
  closureReason ClosureReason? // FILLED / CANCELLED / CLIENT_WITHDREW / ON_HOLD
  closedAt      DateTime?

  isRespondByBreached  Boolean @default(false)
  isTurnaroundBreached Boolean @default(false)

  // ── Audit ─────────────────────────────────────────────────────────────────
  createdById String
  createdBy   User   @relation("RequirementCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("RequirementApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  closedById String?
  closedBy   User?   @relation("RequirementClosedBy", fields: [closedById], references: [id])

  deletedAt DateTime?

  parsedJDId String?
  parsedJD   ParsedJDLibrary? @relation(fields: [parsedJDId], references: [id])


  // ── Website integration ──

  requirementCategoryId String?
  requirementCategory   RequirementCategory? @relation(fields: [requirementCategoryId], references: [id])


  // ── Child relations ───────────────────────────────────────────────────────
  assignments        RequirementAssignment[]
  candidateSnapshots CandidateSnapshot[]
  pipelines          RequirementCandidatePipeline[]
  statusHistory      RequirementStatusHistory[]
  activities         RequirementActivity[]
  notes              RequirementNote[]
  documents          RequirementDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parsedJDId])
  @@index([status])
  @@index([clientId])
  @@index([businessUnitId])
  @@index([serviceLineId])
  @@index([clientSpocId])
  @@index([createdById])
  @@index([isRespondByBreached])
  @@index([isTurnaroundBreached])
  @@index([deletedAt])
  @@index([closureReason])
  @@index([targetDate])
  @@index([requirementCategoryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PARSED JD LIBRARY
// AI parses once — stored here forever. Anyone can search and reuse.
// No AI call needed on reuse — just clone the parsed fields into the form.
// ─────────────────────────────────────────────────────────────────────────────

model ParsedJDLibrary {
  id String @id @default(uuid())

  // searchable identifier — auto-generated from parsed title
  title String // "Senior React Developer" — indexed for search

  // raw parsed output from GPT — everything stored flat for easy cloning
  parsedData Json // full ParsedJD object

  // the original JD file that was parsed
  jdFileKey  String?
  jdFileName String?
  jdFileType String?

  // who parsed it and when
  parsedById String
  parsedBy   User     @relation("JDParsedBy", fields: [parsedById], references: [id])
  parsedAt   DateTime @default(now())

  // usage tracking — who used this and how many times
  usageCount Int      @default(0)
  usedByIds  String[] // array of userIds who cloned this — for "used by X people" display

  // requirements created from this parsed JD
  requirements Requirement[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([isActive])
  @@index([usageCount])
  @@index([parsedById])
}

// ── New enums to add ──────────────────────────────────────────────────────────

enum JobOpenFor {
  EXTERNAL
  INTERNAL
  BOTH
}

enum ClosureReason {
  FILLED
  CANCELLED
  CLIENT_WITHDREW
  ON_HOLD
}

enum JDParseStatus {
  PARSED
  FAILED
  MANUALLY_OVERRIDDEN
}

// ─────────────────────────────────────────────────────────────────────────────
// REQUIREMENT ASSIGNMENT
// depth 0 → sales assigns to DM
// depth 1 → DM assigns to TeamLead or Recruiter
// depth 2 → TeamLead assigns to Recruiter
// ─────────────────────────────────────────────────────────────────────────────

model RequirementAssignment {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("AssignedToUser", fields: [assignedToId], references: [id])

  assignedById String
  assignedBy   User   @relation("AssignedByUser", fields: [assignedById], references: [id])

  assigneeDepartmentId String?
  assigneeDepartment   Department? @relation(fields: [assigneeDepartmentId], references: [id])

  assigneeBUId String?
  assigneeBU   BusinessUnit? @relation("AssignmentBU", fields: [assigneeBUId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  depth              Int                     @default(0)
  parentAssignmentId String?
  parentAssignment   RequirementAssignment?  @relation("AssignmentChain", fields: [parentAssignmentId], references: [id])
  childAssignments   RequirementAssignment[] @relation("AssignmentChain")

  status            AssignmentStatus @default(ACTIVE)
  allocatedOpenings Int?
  filledOpenings    Int              @default(0)
  submissionsCount  Int              @default(0)
  interviewsCount   Int              @default(0)

  deadline       DateTime?
  deadlineMet    Boolean?
  breachedAt     DateTime?
  reminderSentAt DateTime?

  assignedAt    DateTime  @default(now())
  removedAt     DateTime?
  removedReason String?

  pipelines RequirementCandidatePipeline[]

  @@index([requirementId, depth])
  @@index([requirementId, status])
  @@index([assignedToId, status])
  @@index([assignedById])
  @@index([parentAssignmentId])
  @@index([assigneeBUId])
  @@index([assigneeDepartmentId])
  @@index([deadline])
}

model RequirementStatusHistory {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  fromStatus RequirementStatus
  toStatus   RequirementStatus

  changedById String
  changedBy   User   @relation("RequirementStatusChangedBy", fields: [changedById], references: [id])

  reason    String?
  changedAt DateTime @default(now())

  @@index([requirementId])
  @@index([changedAt])
}

model RequirementActivity {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("RequirementActivityActor", fields: [actorId], references: [id])

  type    ActivityType
  summary String
  meta    Json?

  createdAt DateTime @default(now())

  @@index([requirementId, createdAt])
  @@index([actorId])
}

model RequirementNote {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("RequirementNoteAuthor", fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementId])
}

model RequirementDocument {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  fileName String?
  fileKey  String?
  fileType String?
  content  String?

  isIssue       Boolean   @default(false)
  issueResolved Boolean   @default(false)
  resolvedById  String?
  resolvedBy    User?     @relation("RequirementDocResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?

  raisedById String
  raisedBy   User   @relation("RequirementDocRaisedBy", fields: [raisedById], references: [id])

  createdAt DateTime @default(now())

  @@index([requirementId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PIPELINE STAGES
// Seeded once. Admin never creates these.
// serviceLineId null = applies to all service lines
// Only 07A / 07B have serviceLineId set
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// CANDIDATE SNAPSHOT
// Written once when recruiter links a candidate to a requirement.
// candidateServiceId = Candidate Service UUID — stored as plain string, no FK.
// One row per candidate per requirement — frozen at link time, never mutated.
// ─────────────────────────────────────────────────────────────────────────────
// File: schema.prisma
// Path: prisma/schema.prisma  (core service — append near CandidateSnapshot)

// ─────────────────────────────────────────────────────────────────────────────
// CANDIDATE INDEX  (core-side read model / search projection)
// Source of truth = Candidate Service `Candidate`. This is a denormalized,
// always-fresh mirror for search + filter. One row per candidate.
// PK = candidateServiceId, so /candidates/:id detail still resolves against
// Candidate Service unchanged. Kept in sync via syncCandidateToCore
// (upsert, guarded by sourceUpdatedAt). NOT frozen — unlike CandidateSnapshot.
// ─────────────────────────────────────────────────────────────────────────────

model CandidateIndex {
  id String @id // = Candidate.id from Candidate Service, no @default

  // ── Identity ──
  fullName  String
  firstName String?
  lastName  String?
  email     String  @unique
  phone     String?

  // ── Cached profile (mirrors Candidate.cached* + parsed rollups) ──
  currentTitle     String? // ← cachedCurrentTitle
  currentCompany   String? // ← cachedCurrentCompany
  totalExpYears    Float? // ← cachedTotalExpYears
  topSkills        String[] // ← cachedTopSkills (RAW, for display)
  normalizedSkills String[] // ← from CandidateSkill.normalizedSkill (GIN filter target)
  locationCity     String? // ← cachedLocationCity
  locationState    String? // ← cachedLocationState

  // ── Recruiter filters (mirrored from source) ──
  isImmediateJoiner Boolean @default(false)
  noticePeriodDays  Int?

  // ── Flags / provenance ──
  source       String // string mirror of CandidateSource — do NOT redefine enum here
  isActive     Boolean @default(true)
  isBlocked    Boolean @default(false)
  doNotContact Boolean @default(false)

  // ── Optional list-level resume link (active ResumeFile.url) ──
  resumeUrl String?

  // ── Sort / sync bookkeeping ──
  lastActivityAt  DateTime // ← mirrors Candidate.lastActivityAt (default sort)
  sourceUpdatedAt DateTime // ← Candidate.updatedAt — out-of-order sync guard
  syncedAt        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // trgm GIN indexes added via raw SQL migration (fullName/email/company/title)
  @@index([normalizedSkills], type: Gin)
  @@index([topSkills], type: Gin)
  @@index([source])
  @@index([isActive, isBlocked]) // mirrors source composite index
  @@index([doNotContact])
  @@index([isImmediateJoiner])
  @@index([totalExpYears])
  @@index([lastActivityAt])
  @@index([createdAt])
}

model CandidateSnapshot {
  id                 String @id @default(uuid())
  candidateServiceId String // Candidate Service UUID — no cross-service FK

  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  snapshotAt DateTime @default(now())

  // display fields — point-in-time copy, never updated
  fullName       String
  email          String
  phone          String?
  currentTitle   String?
  currentCompany String?
  totalExpYears  Float?
  topSkills      String[]
  resumeUrl      String?

  // full response blob from Candidate Service GET /candidates/:id
  rawSnapshot Json

  // snapshot source
  sourced String?

  createdById String
  createdBy   User   @relation("SnapshotCreatedBy", fields: [createdById], references: [id])

  pipeline RequirementCandidatePipeline?

  createdAt DateTime @default(now())

  @@unique([candidateServiceId, requirementId])
  @@index([requirementId])
  @@index([candidateServiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REQUIREMENT CANDIDATE PIPELINE
// One row per candidate per requirement.
// Live funnel row — current stage, who's handling, submission / offer state.
// Stage pointer updates in place. History written to CandidatePipelineStageLog.
// ─────────────────────────────────────────────────────────────────────────────

enum CandidateDisposition {
  ACTIVE // in pipeline, being worked
  PLACED // joined — counts as fill
  DROPPED // out — reason in dropReason field
  DUPLICATE // ignored
  ON_HOLD
}

enum DropReason {
  CLIENT_REJECTED
  CANDIDATE_DECLINED
  OFFER_EXPIRED
  NO_SHOW
  UNRESPONSIVE
  OVERQUALIFIED
  BUDGET_MISMATCH
  OTHER
}

model RequirementCandidatePipeline {
  id String @id @default(uuid())

  snapshotId String            @unique
  snapshot   CandidateSnapshot @relation(fields: [snapshotId], references: [id])

  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  assignmentId String?
  assignment   RequirementAssignment? @relation(fields: [assignmentId], references: [id])

  recruiterId String
  recruiter   User   @relation("PipelineRecruiter", fields: [recruiterId], references: [id])

  currentStageId   String
  currentStage     PipelineStage @relation(fields: [currentStageId], references: [id])
  stageUpdatedAt   DateTime      @default(now())
  stageUpdatedById String
  stageUpdatedBy   User          @relation("PipelineStageUpdatedBy", fields: [stageUpdatedById], references: [id])

  disposition   CandidateDisposition @default(ACTIVE)
  dispositionAt DateTime?
  dropReason    String?
  dropNote      String?

  // ── Submission
  submissionNote String?
  submittedAt    DateTime?
  submittedById  String?
  submittedBy    User?     @relation("PipelineSubmittedBy", fields: [submittedById], references: [id])

  // ── Offer
  offeredCtc     Float? // formal offer number
  salaryCurrency String?      @default("INR")
  salaryType     SalaryType?
  offeredAt      DateTime?
  offeredById    String?
  offeredBy      User?        @relation("PipelineOfferedBy", fields: [offeredById], references: [id])
  offerStatus    OfferStatus?

  noticePeriod String?

  // ── CTC breakdown
  currentCtc    Float? // what candidate earns now at current company
  expectedCtc   Float? // what candidate asked for
  negotiatedCtc Float? // what was agreed during negotiation
  ctcNotes      String? // free text — any CTC context

  // ── Joining
  lastWorkingDate     DateTime? // LWD at current company
  expectedJoiningDate DateTime? // when we expect them to join
  actualJoiningDate   DateTime? // when they actually joined
  monthOfJoining      String? // "June 2025" — derived on write, stored for reporting
  remainingDaysToJoin Int? // computed on write — negative means overdue, null = no date set

  // ── Rejection
  isRejected      Boolean   @default(false)
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?     @relation("PipelineRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason String?

  // ── Withdrawal
  isWithdrawn     Boolean   @default(false)
  withdrawnAt     DateTime?
  withdrawnReason String?

  // ── Hold
  isOnHold     Boolean   @default(false)
  onHoldAt     DateTime?
  onHoldReason String?

  stageHistory CandidatePipelineStageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //interview
  interviewSchedules CandidateInterviewSchedule[]


  @@index([requirementId, currentStageId])
  @@index([recruiterId])
  @@index([assignmentId])
  @@index([stageUpdatedAt])
  @@index([actualJoiningDate])
  @@index([expectedJoiningDate])
  @@index([monthOfJoining])
  @@index([disposition])
}

// ─────────────────────────────────────────────────────────────────────────────
// STAGE LOG
// Append-only. One row per transition.
// timeInPrevStageMins computed before write — source of all TAT / aging reports.
// ─────────────────────────────────────────────────────────────────────────────

model CandidatePipelineStageLog {
  id String @id @default(uuid())

  pipelineId String
  pipeline   RequirementCandidatePipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   PipelineStage? @relation("StageLogFrom", fields: [fromStageId], references: [id])

  toStageId String
  toStage   PipelineStage @relation("StageLogTo", fields: [toStageId], references: [id])

  fromCanonicalStage CanonicalStage?
  toCanonicalStage   CanonicalStage?

  changedById String
  changedBy   User   @relation("StageLogChangedBy", fields: [changedById], references: [id])

  wasSkipped Boolean @default(false)
  skipReason String?

  timeInPrevStageMins Int?

  note      String?
  createdAt DateTime @default(now())

  @@index([pipelineId, createdAt])
  @@index([toStageId])
  @@index([toCanonicalStage])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?

  referenceId   String
  referenceType NotificationReferenceType

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @default(uuid())

  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id])

  action    String
  module    String
  recordId  String
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([module, recordId])
  @@index([actorId])
  @@index([createdAt])
}

enum CanonicalStage {
  SOURCED
  SCREENING
  SUBMMITED
  SHORTLISTED
  REJECTED
  DECLINED

  INTERVIEW
  INTERVIEW_SCHEDULED
  INTERVIEW_HOLD
  INTERVIEW_RESCHEDULED
  INTERVIEW_CANCELLED

  OFFER_IN_PROGRESS
  OFFERED
  HIRED
  JOINED
  DROPPED

  TRAINING_STARTED
  TRAINING_CANCELLED
  TRAINING_HOLD
  TRAINING_IN_PROGRESS
  TRAINING_COMPLETED
}

enum InterviewMode {
  ONLINE
  OFFLINE
  TELEPHONIC
}
model CandidateInterviewSchedule {
  id String @id @default(uuid())

  pipelineId String
  pipeline   RequirementCandidatePipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  roundNumber Int
  scheduledAt DateTime
  durationMins Int
  mode         InterviewMode
  // status       CanonicalStage

  createdById String
  createdBy   User @relation("InterviewScheduledBy", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineId]) 
  @@index([stageId])
  @@index([scheduledAt])
}

model PipelineStage {
  id             String          @id @default(uuid())
  code           String
  label          String
  order          Int
  canonicalStage CanonicalStage?
  isMandatory    Boolean         @default(true)
  isTerminal     Boolean         @default(false)
  isActive       Boolean         @default(true)

  isStandard Boolean @default(false)

  candidatePipelines RequirementCandidatePipeline[]
  stageHistoriesFrom CandidatePipelineStageLog[]    @relation("StageLogFrom")
  stageHistoriesTo   CandidatePipelineStageLog[]    @relation("StageLogTo")

  createdAt     DateTime     @default(now())
  serviceLine   ServiceLine? @relation(fields: [serviceLineId], references: [id])
  serviceLineId String?

  interviewSchedules CandidateInterviewSchedule[]

  @@index([order])
  @@index([canonicalStage])
}

enum MigrationStagingType {
  UNMAPPED_CREATOR // Requirement's "Created By" email has no matching User
  UNMAPPED_RECRUITER // A recruiter email in "Recruiters"/"Sourced By" col has no matching User
  UNRESOLVED_CHAIN // Both creator and recruiter exist as Users, but no
  // reportingTo/teamLead path connects them
  CLIENT_SPOC_NEEDS_REVIEW // Regex-extracted ClientSpoc, unverified
  DUPLICATE_REQ_CODE // Job ID / Reference ID collided with an existing reqCode
  UNMAPPED_REQUIREMENT // Candidate row's Job ID has no matching Requirement
  UNMAPPED_STAGE // Stage/Substage combo missing from stage-mapping.ts
  PIPELINE_STAGE_NOT_SEEDED // CanonicalStage has no seeded PipelineStage row
  FLAT_FALLBACK_ASSIGNMENT // No hierarchy/assignable path — flat creator->recruiter assignment created (audit record, not a blocker)
  USER_AUTO_CREATED // Creator/recruiter email had no User — auto-created with role MIGRATED, password pass@123. Review and fix role/reporting/BU.
}

enum MigrationStagingStatus {
  PENDING
  RESOLVED
  IGNORED
}

model MigrationStaging {
  id   String               @id @default(uuid())
  type MigrationStagingType

  // Human-readable, e.g. "ta4087@sfjbs.com not found in Users" —
  // this is what you'll actually read when triaging.
  reason String

  // Free-form context needed to resolve this row by hand later:
  // the source xlsx row number, the raw cell values, any partially
  // resolved ids. Keep it dumb and complete.
  payload Json

  // Which xlsx row this came from, for traceability back to the source file.
  sourceRow Int?

  status MigrationStagingStatus @default(PENDING)

  // Once someone manually maps the missing entity (e.g. adds the
  // correct userId here), the promote script picks this up.
  resolvedUserId String?
  resolvedNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([sourceRow])
}


// ─────────────────────────────────────────────────────────────────────────────
// REQUIREMENT CATEGORY
// Flat lookup for grouping/filtering requirements on the SFJ website.
