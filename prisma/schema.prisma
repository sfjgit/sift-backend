generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════
// CORE SERVICE — prisma/schema.prisma
//
// Owns: Users, Roles, Permissions, Business Units,
//       Teams, Clients, Requirements, OrgFlow,
//       Notifications, Activity Feed, AuditLog
//
// Does NOT own: Candidates, Applications, Interviews,
//               Offers, Onboarding, Files, Communications
//               — those live in Candidate Service and
//                 Recruitment Service respectively.
//
// Cross-service note: recruiterId, changedById etc in
// other services are plain strings referencing User.id
// from this service. No FK constraints cross services.
//
// Stats note: filledOpenings, activeApplications etc on
// Requirement are snapshots pushed by Recruitment Service
// via internal API — not computed at query time.
// ═════════════════════════════════════════

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  passwordHash  String
  passwordPlain String?

  firstName       String
  lastName        String
  middleName      String?
  nickName        String?
  displayName     String?
  employeeId      String?   @unique
  phone           String?
  workingLocation String?
  timezone        String?
  dateOfBirth     DateTime?
  dateOfJoin      DateTime?

  isSuperAdmin Boolean @default(false)
  isActive     Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  reportingToId String?
  reportingTo   User?   @relation("ReportsTo", fields: [reportingToId], references: [id])
  subordinates  User[]  @relation("ReportsTo")

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  teamMemberships TeamMember[]
  refreshTokens   RefreshToken[]

  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdByMe User[]  @relation("UserCreatedBy")

  // ── Notification + Activity ──
  notifications         Notification[]        @relation("UserNotifications")
  requirementActivities RequirementActivity[] @relation("RequirementActivityActor")

  // ── Requirement back-relations ──
  requirementsCreated               Requirement[]              @relation("RequirementCreatedBy")
  requirementsApproved              Requirement[]              @relation("RequirementApprovedBy")
  requirementsClosed                Requirement[]              @relation("RequirementClosedBy")
  requirementDocsRaised             RequirementDocument[]      @relation("RequirementDocRaisedBy")
  requirementDocsResolved           RequirementDocument[]      @relation("RequirementDocResolvedBy")
  requirementNotesAuthored          RequirementNote[]          @relation("RequirementNoteAuthor")
  requirementStatusChanges          RequirementStatusHistory[] @relation("RequirementStatusChangedBy")
  requirementAssignmentsGiven       RequirementAssignment[]    @relation("RequirementAssignedBy")
  requirementAssignmentsAsRecruiter RequirementAssignment[]    @relation("RequirementAssignmentRecruiter")

  // ── Client back-relations ──
  clientsCreated                ClientClient[]         @relation("ClientCreatedBy")
  clientsApproved               ClientClient[]         @relation("ClientApprovedBy")
  clientHandlerEntries          ClientHandler[]        @relation("ClientHandlerUser")
  clientHandlersAssigned        ClientHandler[]        @relation("ClientHandlerAssignedBy")
  clientTeamAssignmentsAssigned ClientTeamAssignment[] @relation("ClientTeamAssignedBy")
  clientNotesAuthored           ClientNote[]           @relation("ClientNoteAuthor")

  // ── Team back-relations ──
  teamMembersDeactivated TeamMember[] @relation("TeamMemberDeactivatedBy")
  teamMembersReplaced    TeamMember[] @relation("TeamMemberReplacedByUser")

  // ── OrgFlow + Audit ──
  orgFlowsCreated OrgFlow[]  @relation("OrgFlowCreatedBy")
  orgFlowsUpdated OrgFlow[]  @relation("OrgFlowUpdatedBy")
  auditLogs       AuditLog[] @relation("AuditLogActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
  @@index([roleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────
// ROLES & PERMISSIONS
// ─────────────────────────────────────────

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id     String @id @default(uuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  module    String
  canView   Boolean         @default(false)
  canAdd    Boolean         @default(false)
  canEdit   Boolean         @default(false)
  canDelete Boolean         @default(false)
  scope     PermissionScope @default(OWN)

  @@unique([roleId, module])
}

enum PermissionScope {
  OWN
  TEAM
  MANAGER   // ← sees all teams + recruiters under his assignments
  BU
  ALL
}

// ─────────────────────────────────────────
// BUSINESS UNITS
// ─────────────────────────────────────────

model BusinessUnit {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  parentBUId String?
  parentBU   BusinessUnit?  @relation("BUHierarchy", fields: [parentBUId], references: [id])
  childBUs   BusinessUnit[] @relation("BUHierarchy")

  teams        Team[]
  users        User[]
  clients      ClientClient[]
  requirements Requirement[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

// ─────────────────────────────────────────
// TEAMS
// ─────────────────────────────────────────

model Team {
  id          String        @id @default(uuid())
  name        String
  description String?
  isActive    Boolean       @default(true)
  category    TeamCategory?

  parentTeamId String?
  parentTeam   Team?   @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams   Team[]  @relation("TeamHierarchy")

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  members    TeamMember[]
  dataPolicy TeamDataPolicy @default(SHARED)

  clientAssignments      ClientTeamAssignment[]
  requirementAssignments RequirementAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([businessUnitId])
}

model TeamMember {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamRole TeamRole @default(MEMBER)
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivatedBy      User?     @relation("TeamMemberDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivationReason String?

  replacedByUserId   String?
  replacedByUser     User?        @relation("TeamMemberReplacedByUser", fields: [replacedByUserId], references: [id])
  replacedByMemberId String?
  replacedByMember   TeamMember?  @relation("MemberReplacement", fields: [replacedByMemberId], references: [id])
  replacedMembers    TeamMember[] @relation("MemberReplacement")

  @@unique([userId, teamId])
  @@index([teamId, isActive])
}

enum TeamRole {
  LEAD
  CO_LEAD
  MEMBER
}

enum TeamDataPolicy {
  SHARED
  LEAD_ONLY
}

enum TeamCategory {
  DELIVERY
  SALES
  SUPPORT
  MANAGEMENT
}

// ─────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────

model ClientClient {
  id       String          @id @default(uuid())
  name     String
  vmsName  String?
  category ClientCategory?
  industry String?
  website  String?
  country  String          @default("India")
  state    String?
  city     String?
  address  String?
  status   ClientStatus    @default(PENDING)

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  createdById  String
  createdBy    User      @relation("ClientCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("ClientApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  parentClientId String?
  parentClient   ClientClient?  @relation("ClientFamily", fields: [parentClientId], references: [id])
  childClients   ClientClient[] @relation("ClientFamily")

  contacts        ClientContact[]
  handlers        ClientHandler[]
  teamAssignments ClientTeamAssignment[]
  requirements    Requirement[]
  notes           ClientNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
  @@index([status])
  @@index([businessUnitId])
}

// supports PRIMARY / SECONDARY / BACKUP per client
// @@unique([clientId, role]) enforces only one of each role per client
model ClientHandler {
  id       String            @id @default(uuid())
  clientId String
  client   ClientClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User              @relation("ClientHandlerUser", fields: [userId], references: [id])
  role     ClientHandlerRole @default(PRIMARY)

  assignedById String
  assignedBy   User     @relation("ClientHandlerAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([clientId, userId])
  @@unique([clientId, role])
}

model ClientTeamAssignment {
  id       String       @id @default(uuid())
  clientId String
  client   ClientClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team         @relation(fields: [teamId], references: [id])

  assignedById String
  assignedBy   User     @relation("ClientTeamAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([clientId, teamId])
}

model ClientContact {
  id          String       @id @default(uuid())
  clientId    String
  client      ClientClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  designation String?
  email       String
  phone       String?
  linkedinUrl String?
  isPrimary   Boolean @default(false)
  isActive    Boolean @default(true)

  requirements Requirement[]

  createdAt DateTime @default(now())

  @@index([clientId, isActive])
}

model ClientNote {
  id       String       @id @default(uuid())
  clientId String
  client   ClientClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId String
  author   User         @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum ClientStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum ClientHandlerRole {
  PRIMARY
  SECONDARY
  BACKUP
}

enum ClientCategory {
  PRODUCT
  SERVICE
  CONSULTING
  STAFFING
  GOVERNMENT
  NGO
  OTHER
}

// ─────────────────────────────────────────
// REQUIREMENTS
// ─────────────────────────────────────────

model Requirement {
  id      String @id @default(uuid())
  reqCode String @unique

  title       String
  description String?

  clientId String
  client   ClientClient @relation(fields: [clientId], references: [id])

  clientContactId String?
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id])

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  jobType    RequirementType
  remoteType RemoteType
  priority   Priority        @default(MEDIUM)

  totalOpenings       Int @default(1)
  filledOpenings      Int @default(0)
  // snapshot stats — pushed by Recruitment Service via internal API
  // never compute these at query time
  activeApplications  Int @default(0)
  interviewsScheduled Int @default(0)
  offersRolledOut     Int @default(0)

  location String?
  country  String?

  salaryMin  Float?
  salaryMax  Float?
  salaryType SalaryType?

  startDate      DateTime?
  endDate        DateTime?
  respondBy      DateTime?
  turnaroundDays Int?

  status   RequirementStatus @default(DRAFT)
  closedAt DateTime?

  createdById  String
  createdBy    User      @relation("RequirementCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("RequirementApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // who manually closed this requirement
  closedById String?
  closedBy   User?   @relation("RequirementClosedBy", fields: [closedById], references: [id])

  assignments   RequirementAssignment[]
  documents     RequirementDocument[]
  notes         RequirementNote[]
  statusHistory RequirementStatusHistory[]
  activities    RequirementActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([businessUnitId])
}

model RequirementDocument {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  type     DocumentEventType
  fileName String?
  fileUrl  String?
  fileType String?
  content  String?

  isIssue       Boolean   @default(false)
  issueResolved Boolean   @default(false)
  resolvedById  String?
  resolvedBy    User?     @relation("RequirementDocResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?

  raisedById String
  raisedBy   User     @relation("RequirementDocRaisedBy", fields: [raisedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([requirementId])
}

model RequirementAssignment {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  assignmentType AssignmentType
  status         AssignmentStatus @default(ACTIVE)

  // recruiterId used for both MANAGER and INDIVIDUAL types
  // MANAGER    → delivery manager User.id
  // INDIVIDUAL → recruiter User.id
  // TEAM       → null, teamId is set instead
  recruiterId String?
  recruiter   User?   @relation("RequirementAssignmentRecruiter", fields: [recruiterId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  allocatedOpenings Int?
  filledOpenings    Int @default(0)
  // per-recruiter snapshot stats — pushed by Recruitment Service
  submissionsCount  Int @default(0)
  interviewsCount   Int @default(0)

  isAutoRouted     Boolean @default(false)
  isSystemAssigned Boolean @default(false)

  // full chain: INDIVIDUAL → parent TEAM → parent MANAGER → null
  // use parentAssignmentId to reconstruct who assigned whom
  parentAssignmentId String?
  parentAssignment   RequirementAssignment?  @relation("AssignmentChain", fields: [parentAssignmentId], references: [id])
  childAssignments   RequirementAssignment[] @relation("AssignmentChain")

  assignedById String?
  assignedBy   User?    @relation("RequirementAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  removedAt     DateTime?
  removedReason String?

  @@index([requirementId, status])
  @@index([recruiterId, status])
  @@index([teamId, status])
  @@index([parentAssignmentId])
}

model RequirementNote {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation("RequirementNoteAuthor", fields: [authorId], references: [id])
  content       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementId])
}

model RequirementStatusHistory {
  id            String            @id @default(uuid())
  requirementId String
  requirement   Requirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fromStatus    RequirementStatus
  toStatus      RequirementStatus

  changedById String
  changedBy   User   @relation("RequirementStatusChangedBy", fields: [changedById], references: [id])

  reason    String?
  changedAt DateTime @default(now())

  @@index([requirementId])
}

// ─────────────────────────────────────────
// ACTIVITY FEED
// ─────────────────────────────────────────

// Unified timeline per requirement.
// One row per meaningful event, written in the same
// transaction as the action that triggered it.
// Powers the requirement detail page activity feed.
model RequirementActivity {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("RequirementActivityActor", fields: [actorId], references: [id])

  type    ActivityType
  summary String       // human readable: "Assigned Team Alpha to this requirement"
  meta    Json?        // structured extra data: old/new status, assignee name etc

  createdAt DateTime @default(now())

  @@index([requirementId, createdAt])
  @@index([actorId])
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

// Per-user notification inbox — bell icon in nav.
// Written in the same transaction as the action that triggered it.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type          NotificationType
  title         String                    // "REQ-042 assigned to you"
  body          String?                   // optional longer description

  referenceId   String
  referenceType NotificationReferenceType

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────
// ORG FLOW
// ─────────────────────────────────────────

model OrgFlow {
  id        String       @id @default(uuid())
  fromType  FlowNodeType
  fromId    String
  fromLabel String
  toType    FlowNodeType
  toId      String
  toLabel   String
  relation  String
  isActive  Boolean      @default(true)

  createdById String
  createdBy   User    @relation("OrgFlowCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("OrgFlowUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromType, fromId, toType, toId, relation])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

model AuditLog {
  id String @id @default(uuid())

  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id])

  action    String // CREATE | UPDATE | DELETE
  module    String // REQUIREMENT | CLIENT | USER | TEAM | BU etc
  recordId  String
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([module, recordId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum DocumentEventType {
  FILE_UPLOAD
  STATUS_CHANGE
  ISSUE_RAISED
  NOTE
  POSITION_FILLED
  REQUIREMENT_CLOSED
}

enum AssignmentType {
  MANAGER    // delivery manager assigned by account manager
  TEAM       // team assigned by delivery manager
  INDIVIDUAL // recruiter assigned by team lead
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
  REPLACED
}

enum RequirementType {
  CONTRACT
  PERMANENT
  CONTRACT_TO_HIRE
  FREELANCE
}

enum RemoteType {
  ONSITE
  REMOTE
  HYBRID
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RequirementStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  CLOSED
  CANCELLED
}

enum SalaryType {
  MONTHLY
  ANNUAL
  HOURLY
  DAILY
}

enum FlowNodeType {
  BUSINESS_UNIT
  TEAM
  USER
  CLIENT
  REQUIREMENT
}

enum ActivityType {
  REQUIREMENT_CREATED
  REQUIREMENT_APPROVED
  REQUIREMENT_CLOSED
  STATUS_CHANGED
  MANAGER_ASSIGNED
  TEAM_ASSIGNED
  RECRUITER_ASSIGNED
  ASSIGNMENT_REMOVED
  NOTE_ADDED
  DOCUMENT_UPLOADED
  ISSUE_RAISED
  ISSUE_RESOLVED
  STATS_UPDATED
}

enum NotificationType {
  REQUIREMENT_ASSIGNED
  TEAM_ASSIGNED
  STATUS_CHANGED
  REQUIREMENT_CLOSED
  NOTE_ADDED
  ISSUE_RAISED
}

enum NotificationReferenceType {
  REQUIREMENT
  ASSIGNMENT
  NOTE
  DOCUMENT
}