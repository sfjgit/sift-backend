generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════
// CORE SERVICE — prisma/schema.prisma
//
// Owns: Users, Roles, Permissions, Business Units,
//       Teams, Clients, Requirements, OrgFlow, AuditLog
//
// Does NOT own: Candidates, Applications, Interviews,
//               Offers, Onboarding, Files, Communications
//               — those live in Candidate Service and
//                 Recruitment Service respectively.
//
// Cross-service note: recruiterId, changedById etc in
// other services are plain strings referencing User.id
// from this service. No FK constraints cross services.
// ═════════════════════════════════════════

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  passwordHash  String
  passwordPlain String?

  firstName       String
  lastName        String
  middleName      String?
  nickName        String?
  displayName     String?
  employeeId      String?   @unique
  phone           String?
  workingLocation String?
  timezone        String?
  dateOfBirth     DateTime?
  dateOfJoin      DateTime?

  isSuperAdmin Boolean @default(false)
  isActive     Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  reportingToId String?
  reportingTo   User?   @relation("ReportsTo", fields: [reportingToId], references: [id])
  subordinates  User[]  @relation("ReportsTo")

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  teamMemberships TeamMember[]
  refreshTokens   RefreshToken[]

  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdByMe User[]  @relation("UserCreatedBy")

  // ── Core Service back-relations only ──
  // All candidate/application/interview/offer relations
  // have been removed — those services reference User.id
  // as plain strings and call this service's API for display data.

  clientsCreated             Client[]                   @relation("ClientCreatedBy")
  clientsApproved            Client[]                   @relation("ClientApprovedBy")
  clientHandlerEntries       ClientHandler[]            @relation("ClientHandlerUser")
  clientHandlersAssigned     ClientHandler[]            @relation("ClientHandlerAssignedBy")
  clientTeamAssignmentsAssigned ClientTeamAssignment[]  @relation("ClientTeamAssignedBy")
  contactHandlerEntries      ContactHandler[]           @relation("ContactHandlerUser")
  contactHandlersAssigned    ContactHandler[]           @relation("ContactHandlerAssignedBy")
  clientNotesAuthored        ClientNote[]               @relation("ClientNoteAuthor")

  requirementsCreated        Requirement[]              @relation("RequirementCreatedBy")
  requirementsApproved       Requirement[]              @relation("RequirementApprovedBy")
  requirementsAsDeliveryLead Requirement[]              @relation("RequirementDeliveryLead")
  requirementsAsTeamLead     Requirement[]              @relation("RequirementTeamLead")
  requirementDocsRaised      RequirementDocument[]      @relation("RequirementDocRaisedBy")
  requirementDocsResolved    RequirementDocument[]      @relation("RequirementDocResolvedBy")
  requirementNotesAuthored   RequirementNote[]          @relation("RequirementNoteAuthor")
  requirementStatusChanges   RequirementStatusHistory[] @relation("RequirementStatusChangedBy")
  requirementAssignmentsGiven      RequirementAssignment[] @relation("RequirementAssignedBy")
  requirementAssignmentsAsRecruiter RequirementAssignment[] @relation("RequirementAssignmentRecruiter")

  teamMembersDeactivated     TeamMember[]               @relation("TeamMemberDeactivatedBy")
  teamMembersReplaced        TeamMember[]               @relation("TeamMemberReplacedByUser")

  orgFlowsCreated            OrgFlow[]                  @relation("OrgFlowCreatedBy")
  orgFlowsUpdated            OrgFlow[]                  @relation("OrgFlowUpdatedBy")

  auditLogs                  AuditLog[]                 @relation("AuditLogActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
  @@index([roleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────
// ROLES & PERMISSIONS
// ─────────────────────────────────────────

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id     String @id @default(uuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  module    String
  canView   Boolean         @default(false)
  canAdd    Boolean         @default(false)
  canEdit   Boolean         @default(false)
  canDelete Boolean         @default(false)
  scope     PermissionScope @default(OWN)

  @@unique([roleId, module])
}

enum PermissionScope {
  OWN
  TEAM
  BU
  ALL
}

// ─────────────────────────────────────────
// BUSINESS UNITS
// ─────────────────────────────────────────

model BusinessUnit {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  parentBUId String?
  parentBU   BusinessUnit?  @relation("BUHierarchy", fields: [parentBUId], references: [id])
  childBUs   BusinessUnit[] @relation("BUHierarchy")

  teams        Team[]
  users        User[]
  clients      Client[]
  requirements Requirement[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

// ─────────────────────────────────────────
// TEAMS
// ─────────────────────────────────────────

model Team {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  category    String?

  parentTeamId String?
  parentTeam   Team?   @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams   Team[]  @relation("TeamHierarchy")

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  members    TeamMember[]
  dataPolicy TeamDataPolicy @default(SHARED)

  clientAssignments      ClientTeamAssignment[]
  requirementAssignments RequirementAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([businessUnitId])
}

model TeamMember {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamRole TeamRole @default(MEMBER)
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivatedBy      User?     @relation("TeamMemberDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivationReason String?

  replacedByUserId   String?
  replacedByUser     User?        @relation("TeamMemberReplacedByUser", fields: [replacedByUserId], references: [id])
  replacedByMemberId String?
  replacedByMember   TeamMember?  @relation("MemberReplacement", fields: [replacedByMemberId], references: [id])
  replacedMembers    TeamMember[] @relation("MemberReplacement")

  @@unique([userId, teamId])
  @@index([teamId, isActive])
}

enum TeamRole {
  LEAD
  CO_LEAD
  MEMBER
}

enum TeamDataPolicy {
  SHARED
  LEAD_ONLY
}

// ─────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────

model Client {
  id       String       @id @default(uuid())
  name     String
  vmsName  String?
  category String?
  industry String?
  website  String?
  country  String       @default("India")
  state    String?
  city     String?
  address  String?
  status   ClientStatus @default(PENDING)

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  createdById  String
  createdBy    User      @relation("ClientCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("ClientApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  parentClientId String?
  parentClient   Client?  @relation("ClientFamily", fields: [parentClientId], references: [id])
  childClients   Client[] @relation("ClientFamily")

  contacts        ClientContact[]
  handlers        ClientHandler[]
  teamAssignments ClientTeamAssignment[]
  requirements    Requirement[]
  notes           ClientNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([businessUnitId])
}

model ClientHandler {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("ClientHandlerUser", fields: [userId], references: [id])
  role     String // PRIMARY | SECONDARY | BACKUP

  assignedById String
  assignedBy   User     @relation("ClientHandlerAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([clientId, userId])
}

model ClientTeamAssignment {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])

  assignedById String
  assignedBy   User     @relation("ClientTeamAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([clientId, teamId])
}

model ClientContact {
  id          String  @id @default(uuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  designation String?
  email       String
  phone       String?
  linkedinUrl String?
  isPrimary   Boolean @default(false)
  isActive    Boolean @default(true)

  handlers     ContactHandler[]
  requirements Requirement[]

  createdAt DateTime @default(now())

  @@index([clientId, isActive])
}

model ContactHandler {
  id        String        @id @default(uuid())
  contactId String
  contact   ClientContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("ContactHandlerUser", fields: [userId], references: [id])

  assignedById String
  assignedBy   User     @relation("ContactHandlerAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([contactId, userId])
}

model ClientNote {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum ClientStatus {
  PENDING
  ACTIVE
  INACTIVE
}

// ─────────────────────────────────────────
// REQUIREMENTS
// ─────────────────────────────────────────

model Requirement {
  id      String @id @default(uuid())
  reqCode String @unique

  title       String
  description String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  clientContactId String?
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id])

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  jobType    RequirementType
  remoteType RemoteType
  priority   Priority        @default(MEDIUM)

  totalOpenings  Int @default(1)
  filledOpenings Int @default(0)

  location String?
  country  String?

  salaryMin  Float?
  salaryMax  Float?
  salaryType String?

  startDate      DateTime?
  endDate        DateTime?
  respondBy      DateTime?
  turnaroundDays Int?
  closedAt       DateTime?

  status RequirementStatus @default(DRAFT)

  createdById  String
  createdBy    User      @relation("RequirementCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("RequirementApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  deliveryLeadId String?
  deliveryLead   User?   @relation("RequirementDeliveryLead", fields: [deliveryLeadId], references: [id])
  teamLeadId     String?
  teamLead       User?   @relation("RequirementTeamLead", fields: [teamLeadId], references: [id])

  assignments   RequirementAssignment[]
  documents     RequirementDocument[]
  notes         RequirementNote[]
  statusHistory RequirementStatusHistory[]

  // No Application[] relation here —
  // Applications live in Recruitment Service.
  // Fetch application count via internal API call to Recruitment Service.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([businessUnitId])
}

model RequirementDocument {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  type     DocumentEventType
  fileName String?
  fileUrl  String?
  fileType String?
  content  String?

  isIssue       Boolean   @default(false)
  issueResolved Boolean   @default(false)
  resolvedById  String?
  resolvedBy    User?     @relation("RequirementDocResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?

  raisedById String
  raisedBy   User     @relation("RequirementDocRaisedBy", fields: [raisedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([requirementId])
}

enum DocumentEventType {
  FILE_UPLOAD
  STATUS_CHANGE
  ISSUE_RAISED
  NOTE
  POSITION_FILLED
  REQUIREMENT_CLOSED
}

model RequirementAssignment {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  assignmentType AssignmentType
  status         AssignmentStatus @default(ACTIVE)

  recruiterId String?
  recruiter   User?   @relation("RequirementAssignmentRecruiter", fields: [recruiterId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  allocatedOpenings Int?
  filledOpenings    Int  @default(0)

  isAutoRouted     Boolean @default(false)
  isSystemAssigned Boolean @default(false)

  assignedById String?
  assignedBy   User?    @relation("RequirementAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  removedAt     DateTime?
  removedReason String?

  @@index([requirementId, status])
  @@index([recruiterId, status])
}

enum AssignmentType {
  INDIVIDUAL
  TEAM
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
  REPLACED
}

model RequirementNote {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation("RequirementNoteAuthor", fields: [authorId], references: [id])
  content       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementId])
}

model RequirementStatusHistory {
  id            String            @id @default(uuid())
  requirementId String
  requirement   Requirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fromStatus    RequirementStatus
  toStatus      RequirementStatus

  changedById String
  changedBy   User   @relation("RequirementStatusChangedBy", fields: [changedById], references: [id])

  reason    String?
  changedAt DateTime @default(now())

  @@index([requirementId])
}

enum RequirementType {
  CONTRACT
  PERMANENT
  CONTRACT_TO_HIRE
  FREELANCE
}

enum RemoteType {
  ONSITE
  REMOTE
  HYBRID
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RequirementStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  CLOSED
  CANCELLED
}

// ─────────────────────────────────────────
// ORG FLOW
// ─────────────────────────────────────────

model OrgFlow {
  id        String       @id @default(uuid())
  fromType  FlowNodeType
  fromId    String
  fromLabel String
  toType    FlowNodeType
  toId      String
  toLabel   String
  relation  String
  isActive  Boolean      @default(true)

  createdById String
  createdBy   User    @relation("OrgFlowCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("OrgFlowUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromType, fromId, toType, toId, relation])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

enum FlowNodeType {
  BUSINESS_UNIT
  TEAM
  USER
  CLIENT
  REQUIREMENT
  // CANDIDATE and APPLICATION removed —
  // those node types live in their respective services
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

model AuditLog {
  id String @id @default(uuid())

  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id])

  action    String  // CREATE | UPDATE | DELETE
  module    String  // REQUIREMENT | CLIENT | USER | TEAM | BU etc
  recordId  String
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([module, recordId])
  @@index([actorId])
  @@index([createdAt])
}