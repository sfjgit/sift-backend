generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum PermissionScope {
  OWN
  TEAM
  REPORTING
  DEPARTMENT
  BU
  ALL
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
  REPLACED
}

enum RequirementType {
  CONTRACT
  PERMANENT
  CONTRACT_TO_HIRE
  FREELANCE
}

enum RemoteType {
  ONSITE
  REMOTE
  HYBRID
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RequirementStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  CLOSED
  CANCELLED
}

enum SalaryType {
  MONTHLY
  ANNUAL
  HOURLY
  DAILY
}

enum ActivityType {
  REQUIREMENT_CREATED
  REQUIREMENT_APPROVED
  REQUIREMENT_CLOSED
  STATUS_CHANGED
  MANAGER_ASSIGNED
  RECRUITER_ASSIGNED
  ASSIGNMENT_REMOVED
  NOTE_ADDED
  DOCUMENT_UPLOADED
  ISSUE_RAISED
  ISSUE_RESOLVED
  STATS_UPDATED
}

enum NotificationType {
  REQUIREMENT_ASSIGNED
  STATUS_CHANGED
  REQUIREMENT_CLOSED
  NOTE_ADDED
  ISSUE_RAISED
  DEADLINE_BREACHED
  DEADLINE_REMINDER
}

enum NotificationReferenceType {
  REQUIREMENT
  ASSIGNMENT
  NOTE
  DOCUMENT
}

enum ClientStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// BUSINESS UNIT
// ancestorIds — includes self + all ancestors, maintained by buService on write
// always store exact BU id on any relation
// filter by passing any ancestor BU id → ancestorIds: { has: buId }
// ─────────────────────────────────────────────────────────────────────────────

model BusinessUnit {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String? @unique
  isActive Boolean @default(true)

  parentBUId String?
  parentBU   BusinessUnit?  @relation("BUHierarchy", fields: [parentBUId], references: [id])
  childBUs   BusinessUnit[] @relation("BUHierarchy")

  ancestorIds String[]

  clients     Client[]
  clientSpocs ClientSpoc[]

  requirementsBU Requirement[]           @relation("RequirementBU")
  assignmentsBU  RequirementAssignment[] @relation("AssignmentBU")

  createdAt DateTime @default(now())

  @@index([isActive])
  @@index([parentBUId])
  @@index([ancestorIds], type: Gin)
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICE LINE — flat, KaaS / TaaS / CSR / OEM
// ─────────────────────────────────────────────────────────────────────────────

model ServiceLine {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String? @unique
  isActive Boolean @default(true)

  clientSpocs    ClientSpoc[]
  requirements   Requirement[]
  pipelineStages PipelineStage[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// DEPARTMENT — flat label, admin-managed
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String?
  isActive Boolean @default(true)

  users       User[]
  assignments RequirementAssignment[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  firstName       String
  lastName        String
  middleName      String?
  displayName     String?
  employeeId      String?   @unique
  phone           String?
  workingLocation String?
  timezone        String?
  dateOfBirth     DateTime?
  dateOfJoin      DateTime?

  isSuperAdmin Boolean @default(false)
  isActive     Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  reportingToId String?
  reportingTo   User?   @relation("ReportsTo", fields: [reportingToId], references: [id])
  subordinates  User[]  @relation("ReportsTo")

  teamLeadId  String?
  teamLead    User?   @relation("TeamLeadOf", fields: [teamLeadId], references: [id])
  teamMembers User[]  @relation("TeamLeadOf")

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdByMe User[]  @relation("UserCreatedBy")

  refreshTokens RefreshToken[]

  spocsHandled ClientSpoc[] @relation("SpocHandler")
  spocsAdded   ClientSpoc[] @relation("SpocAddedBy")

  clientsCreated      Client[]     @relation("ClientCreatedBy")
  clientsApproved     Client[]     @relation("ClientApprovedBy")
  clientNotesAuthored ClientNote[] @relation("ClientNoteAuthor")

  requirementsCreated      Requirement[]              @relation("RequirementCreatedBy")
  requirementsApproved     Requirement[]              @relation("RequirementApprovedBy")
  requirementsClosed       Requirement[]              @relation("RequirementClosedBy")
  requirementStatusChanges RequirementStatusHistory[] @relation("RequirementStatusChangedBy")
  requirementActivities    RequirementActivity[]      @relation("RequirementActivityActor")
  requirementNotesAuthored RequirementNote[]          @relation("RequirementNoteAuthor")
  requirementDocsRaised    RequirementDocument[]      @relation("RequirementDocRaisedBy")
  requirementDocsResolved  RequirementDocument[]      @relation("RequirementDocResolvedBy")

  assignmentsGiven    RequirementAssignment[] @relation("AssignedByUser")
  assignmentsReceived RequirementAssignment[] @relation("AssignedToUser")

  // pipeline relations
  pipelinesHandling    RequirementCandidatePipeline[] @relation("PipelineRecruiter")
  pipelinesStageUpdate RequirementCandidatePipeline[] @relation("PipelineStageUpdatedBy")
  pipelinesSubmitted   RequirementCandidatePipeline[] @relation("PipelineSubmittedBy")
  pipelinesOffered     RequirementCandidatePipeline[] @relation("PipelineOfferedBy")
  pipelinesRejected    RequirementCandidatePipeline[] @relation("PipelineRejectedBy")
  pipelineStageChanges CandidatePipelineStageLog[]    @relation("StageLogChangedBy")

  candidateSnapshotsCreated CandidateSnapshot[] @relation("SnapshotCreatedBy")

  notifications Notification[] @relation("UserNotifications")
  auditLogs     AuditLog[]     @relation("AuditLogActor")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  userAppCredentials UserAppCredential[]

  @@index([email])
  @@index([isActive])
  @@index([roleId])
  @@index([departmentId])
  @@index([reportingToId])
  @@index([teamLeadId])
}

model UserAppCredential {
  id        String   @id @default(uuid())
  userId    String
  appName   String // 'NAUKRI', 'LINKEDIN', 'GITHUB', etc.
  email     String
  password  String // AES-256 encrypted
  metadata  Json? // any extra fields — API keys, tokens, org IDs, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appName]) // one credential per app per user
  @@map("user_app_credentials")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ROLES & PERMISSIONS
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Module {
  id       String  @id @default(uuid())
  name     String  @unique  // "users", "clients", "requirements"
  label    String           // "Users", "Clients", "Requirements"
  order    Int?
  isActive Boolean @default(true)

  permissions RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  id     String @id @default(uuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  module String

   moduleId String?
  modules   Module? @relation(fields: [moduleId], references: [id])

  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  canViewScope   PermissionScope @default(OWN)
  canAddScope    PermissionScope @default(OWN)
  canEditScope   PermissionScope @default(OWN)
  canDeleteScope PermissionScope @default(OWN)

  @@unique([roleId, module])
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id       String       @id @default(uuid())
  name     String
  vmsName  String?
  industry String?
  website  String?
  country  String?
  state    String?
  city     String?
  address  String?
  status   ClientStatus @default(PENDING)

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  parentClientId String?
  parentClient   Client?  @relation("ClientFamily", fields: [parentClientId], references: [id])
  childClients   Client[] @relation("ClientFamily")

  createdById  String
  createdBy    User      @relation("ClientCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("ClientApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  deletedAt DateTime?

  spocs        ClientSpoc[]
  requirements Requirement[]
  notes        ClientNote[]
  assignments  RequirementAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([businessUnitId])
  @@index([deletedAt])
}

model ClientSpoc {
  id String @id @default(uuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  firstName   String
  lastName    String
  email       String?
  phone       String?
  designation String?
  department  String?

  handlerId String
  handler   User   @relation("SpocHandler", fields: [handlerId], references: [id])

  serviceLineId String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id])

  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)
  notes     String?

  addedById String
  addedBy   User   @relation("SpocAddedBy", fields: [addedById], references: [id])

  requirements Requirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, email, serviceLineId])
  @@index([clientId, isActive])
  @@index([handlerId, isActive])
  @@index([businessUnitId])
  @@index([serviceLineId])
}

model ClientNote {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REQUIREMENT
// ─────────────────────────────────────────────────────────────────────────────

model Requirement {
  id      String @id @default(uuid())
  reqCode String @unique

  title         String
  description   String?
  jobType       RequirementType
  remoteType    RemoteType
  priority      Priority        @default(MEDIUM)
  location      String?
  country       String?
  experienceMin Float?
  experienceMax Float?
  salaryMin     Float?
  salaryMax     Float?
  salaryType    SalaryType?
  skills        String[]

  jdFileKey    String?
  jdFileName   String?
  jdFileType   String?
  jdUploadedAt DateTime?

  clientSpocId String?
  clientSpoc   ClientSpoc? @relation(fields: [clientSpocId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  businessUnitId String?
  businessUnit   BusinessUnit? @relation("RequirementBU", fields: [businessUnitId], references: [id])

  serviceLineId String?
  serviceLine   ServiceLine? @relation(fields: [serviceLineId], references: [id])

  // counters — bumped by pipeline stage transition service
  totalOpenings       Int @default(1)
  filledOpenings      Int @default(0)
  activeApplications  Int @default(0)
  interviewsScheduled Int @default(0)
  offersRolledOut     Int @default(0)

  startDate      DateTime?
  endDate        DateTime?
  respondBy      DateTime?
  turnaroundDays Int?

  status   RequirementStatus @default(DRAFT)
  closedAt DateTime?

  isRespondByBreached  Boolean @default(false)
  isTurnaroundBreached Boolean @default(false)

  createdById  String
  createdBy    User      @relation("RequirementCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("RequirementApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  closedById   String?
  closedBy     User?     @relation("RequirementClosedBy", fields: [closedById], references: [id])

  deletedAt DateTime?

  assignments        RequirementAssignment[]
  candidateSnapshots CandidateSnapshot[]
  pipelines          RequirementCandidatePipeline[]
  statusHistory      RequirementStatusHistory[]
  activities         RequirementActivity[]
  notes              RequirementNote[]
  documents          RequirementDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([businessUnitId])
  @@index([serviceLineId])
  @@index([clientSpocId])
  @@index([createdById])
  @@index([isRespondByBreached])
  @@index([isTurnaroundBreached])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// REQUIREMENT ASSIGNMENT
// depth 0 → sales assigns to DM
// depth 1 → DM assigns to TeamLead or Recruiter
// depth 2 → TeamLead assigns to Recruiter
// ─────────────────────────────────────────────────────────────────────────────

model RequirementAssignment {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("AssignedToUser", fields: [assignedToId], references: [id])

  assignedById String
  assignedBy   User   @relation("AssignedByUser", fields: [assignedById], references: [id])

  assigneeDepartmentId String?
  assigneeDepartment   Department? @relation(fields: [assigneeDepartmentId], references: [id])

  assigneeBUId String?
  assigneeBU   BusinessUnit? @relation("AssignmentBU", fields: [assigneeBUId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  depth              Int                     @default(0)
  parentAssignmentId String?
  parentAssignment   RequirementAssignment?  @relation("AssignmentChain", fields: [parentAssignmentId], references: [id])
  childAssignments   RequirementAssignment[] @relation("AssignmentChain")

  status            AssignmentStatus @default(ACTIVE)
  allocatedOpenings Int?
  filledOpenings    Int              @default(0)
  submissionsCount  Int              @default(0)
  interviewsCount   Int              @default(0)

  deadline       DateTime?
  deadlineMet    Boolean?
  breachedAt     DateTime?
  reminderSentAt DateTime?

  assignedAt    DateTime  @default(now())
  removedAt     DateTime?
  removedReason String?

  pipelines RequirementCandidatePipeline[]

  @@index([requirementId, depth])
  @@index([requirementId, status])
  @@index([assignedToId, status])
  @@index([assignedById])
  @@index([parentAssignmentId])
  @@index([assigneeBUId])
  @@index([assigneeDepartmentId])
  @@index([deadline])
}

model RequirementStatusHistory {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  fromStatus RequirementStatus
  toStatus   RequirementStatus

  changedById String
  changedBy   User   @relation("RequirementStatusChangedBy", fields: [changedById], references: [id])

  reason    String?
  changedAt DateTime @default(now())

  @@index([requirementId])
  @@index([changedAt])
}

model RequirementActivity {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("RequirementActivityActor", fields: [actorId], references: [id])

  type    ActivityType
  summary String
  meta    Json?

  createdAt DateTime @default(now())

  @@index([requirementId, createdAt])
  @@index([actorId])
}

model RequirementNote {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("RequirementNoteAuthor", fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementId])
}

model RequirementDocument {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  fileName String?
  fileKey  String?
  fileType String?
  content  String?

  isIssue       Boolean   @default(false)
  issueResolved Boolean   @default(false)
  resolvedById  String?
  resolvedBy    User?     @relation("RequirementDocResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?

  raisedById String
  raisedBy   User   @relation("RequirementDocRaisedBy", fields: [raisedById], references: [id])

  createdAt DateTime @default(now())

  @@index([requirementId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PIPELINE STAGES
// Seeded once. Admin never creates these.
// serviceLineId null = applies to all service lines
// Only 07A / 07B have serviceLineId set
// ─────────────────────────────────────────────────────────────────────────────

model PipelineStage {
  id            String  @id @default(uuid())
  code          String  @unique // "01", "02", "07A", "07B", "10"
  label         String // "Sourced", "KaaS Review", "Joined"
  order         Int // 1,2,...10 — 07A and 07B both have order 7
  serviceLineId String? // null = all service lines, set only for 07A / 07B
  isMandatory   Boolean @default(true)
  isTerminal    Boolean @default(false) // true only for Joined
  isActive      Boolean @default(true)

  serviceLine ServiceLine? @relation(fields: [serviceLineId], references: [id])

  candidatePipelines RequirementCandidatePipeline[]
  stageHistoriesFrom CandidatePipelineStageLog[]    @relation("StageLogFrom")
  stageHistoriesTo   CandidatePipelineStageLog[]    @relation("StageLogTo")

  @@index([order])
  @@index([serviceLineId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CANDIDATE SNAPSHOT
// Written once when recruiter links a candidate to a requirement.
// candidateServiceId = Candidate Service UUID — stored as plain string, no FK.
// One row per candidate per requirement — frozen at link time, never mutated.
// ─────────────────────────────────────────────────────────────────────────────

model CandidateSnapshot {
  id                 String @id @default(uuid())
  candidateServiceId String // Candidate Service UUID — no cross-service FK

  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  snapshotAt DateTime @default(now())

  // display fields — point-in-time copy, never updated
  fullName       String
  email          String
  phone          String?
  currentTitle   String?
  currentCompany String?
  totalExpYears  Float?
  topSkills      String[]
  resumeUrl      String?

  // full response blob from Candidate Service GET /candidates/:id
  rawSnapshot Json

  createdById String
  createdBy   User   @relation("SnapshotCreatedBy", fields: [createdById], references: [id])

  pipeline RequirementCandidatePipeline?

  createdAt DateTime @default(now())

  @@unique([candidateServiceId, requirementId])
  @@index([requirementId])
  @@index([candidateServiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REQUIREMENT CANDIDATE PIPELINE
// One row per candidate per requirement.
// Live funnel row — current stage, who's handling, submission / offer state.
// Stage pointer updates in place. History written to CandidatePipelineStageLog.
// ─────────────────────────────────────────────────────────────────────────────

model RequirementCandidatePipeline {
  id String @id @default(uuid())

  snapshotId String            @unique
  snapshot   CandidateSnapshot @relation(fields: [snapshotId], references: [id])

  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  assignmentId String?
  assignment   RequirementAssignment? @relation(fields: [assignmentId], references: [id])

  recruiterId String
  recruiter   User   @relation("PipelineRecruiter", fields: [recruiterId], references: [id])

  currentStageId   String
  currentStage     PipelineStage @relation(fields: [currentStageId], references: [id])
  stageUpdatedAt   DateTime      @default(now())
  stageUpdatedById String
  stageUpdatedBy   User          @relation("PipelineStageUpdatedBy", fields: [stageUpdatedById], references: [id])

  // submission to client
  submissionNote String?
  submittedAt    DateTime?
  submittedById  String?
  submittedBy    User?     @relation("PipelineSubmittedBy", fields: [submittedById], references: [id])

  // offer
  offeredCtc          Float?
  salaryCurrency      String?      @default("INR")
  salaryType          SalaryType?
  offeredAt           DateTime?
  offeredById         String?
  offeredBy           User?        @relation("PipelineOfferedBy", fields: [offeredById], references: [id])
  offerStatus         OfferStatus?
  expectedJoiningDate DateTime?
  actualJoiningDate   DateTime?

  // terminal states — can happen from any stage
  isRejected      Boolean   @default(false)
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?     @relation("PipelineRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason String?

  isWithdrawn     Boolean   @default(false)
  withdrawnAt     DateTime?
  withdrawnReason String?

  isOnHold     Boolean   @default(false)
  onHoldAt     DateTime?
  onHoldReason String?

  stageHistory CandidatePipelineStageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementId, currentStageId])
  @@index([recruiterId])
  @@index([assignmentId])
  @@index([stageUpdatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// STAGE LOG
// Append-only. One row per transition.
// timeInPrevStageMins computed before write — source of all TAT / aging reports.
// ─────────────────────────────────────────────────────────────────────────────

model CandidatePipelineStageLog {
  id String @id @default(uuid())

  pipelineId String
  pipeline   RequirementCandidatePipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   PipelineStage? @relation("StageLogFrom", fields: [fromStageId], references: [id])

  toStageId String
  toStage   PipelineStage @relation("StageLogTo", fields: [toStageId], references: [id])

  changedById String
  changedBy   User   @relation("StageLogChangedBy", fields: [changedById], references: [id])

  wasSkipped Boolean @default(false)
  skipReason String?

  // how long candidate sat in the previous stage before this transition
  timeInPrevStageMins Int?

  note      String?
  createdAt DateTime @default(now())

  @@index([pipelineId, createdAt])
  @@index([toStageId])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?

  referenceId   String
  referenceType NotificationReferenceType

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @default(uuid())

  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id])

  action    String
  module    String
  recordId  String
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([module, recordId])
  @@index([actorId])
  @@index([createdAt])
}
